<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StreamHelper</AssemblyName>
    <RootNamespace>StreamHelper</RootNamespace>
    <Version>1.0.0.0</Version>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app_icon.ico" />
    <Resource Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StreamHelper.Tests" />
  </ItemGroup>

  <Target Name="WriteReleaseChecksum" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <GetFileHash Files="$(PublishDir)$(AssemblyName).exe" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="ReleaseExeHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(PublishDir)$(AssemblyName).exe.sha256" Lines="$(ReleaseExeHash)  $(AssemblyName).exe" Overwrite="true" />
  </Target>

</Project>
