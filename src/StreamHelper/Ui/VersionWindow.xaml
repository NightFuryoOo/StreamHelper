<Window x:Class="StreamHelper.Ui.VersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор версии" Icon="/app_icon.ico" Width="460" Height="540" MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="VersionItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="#262A33" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="12,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2B303B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26314A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding CurrentText}" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="HintText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>

        <ListBox x:Name="VersionList" Grid.Row="2" Background="Transparent" BorderThickness="0" IsEnabled="{Binding NotBusy}"
                 ItemContainerStyle="{StaticResource VersionItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Версии" SelectionChanged="OnSelected">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Mark}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DateText}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="ListMessage" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="ListMessageText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button x:Name="RetryButton" Style="{StaticResource FlatButton}" Content="Повторить" HorizontalAlignment="Center" Margin="0,6,0,0"
                    Visibility="Collapsed" Click="OnRetry"/>
        </StackPanel>

        <ScrollViewer x:Name="NotesBox" Grid.Row="3" MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="WarnText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <StackPanel IsEnabled="{Binding NotBusy}">
                <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Установить" IsEnabled="False" Click="OnInstall"/>
            </StackPanel>
            <Button Style="{StaticResource FlatButton}" Content="Закрыть" Margin="8,0,0,0" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>