<Window x:Class="StreamHelper.Ui.MuteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мут" Icon="/app_icon.ico" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Мут" Foreground="{StaticResource MutedBrush}"/>
        <TextBlock x:Name="NickText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

        <TextBlock Text="На сколько" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,3"/>
        <DockPanel>
            <TextBox x:Name="TimeBox" DockPanel.Dock="Left" Width="90" MaxLength="7" FontSize="15"
                     AutomationProperties.Name="Время мута" PreviewTextInput="OnTimeInput" TextChanged="OnTimeChanged"
                     DataObject.Pasting="OnTimePasting"/>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="UnitSeconds" Style="{StaticResource TabButton}" GroupName="unit" Content="сек" AutomationProperties.Name="секунды"/>
                <RadioButton x:Name="UnitMinutes" Style="{StaticResource TabButton}" GroupName="unit" Content="мин" Margin="2,0,0,0" IsChecked="True" AutomationProperties.Name="минуты"/>
                <RadioButton x:Name="UnitHours" Style="{StaticResource TabButton}" GroupName="unit" Content="ч" Margin="2,0,0,0" AutomationProperties.Name="часы"/>
                <RadioButton x:Name="UnitDays" Style="{StaticResource TabButton}" GroupName="unit" Content="сут" Margin="2,0,0,0" AutomationProperties.Name="сутки"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button x:Name="MuteButton" Style="{StaticResource PrimaryButton}" Content="Замутить" Click="OnMute"/>
            <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="8,0,0,0" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
