<Window x:Class="StreamHelper.Ui.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StreamHelper.Ui"
        Title="StreamHelper — что умеет программа" Icon="/app_icon.ico" Width="900" Height="700" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#8DBBFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="HelpCopyMenu" x:Shared="False">
            <MenuItem Header="Копировать" Command="ApplicationCommands.Copy"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Выделить всё" Command="ApplicationCommands.SelectAll"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
        <Style TargetType="ui:HelpTextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="IsDocumentEnabled" Value="True"/>
            <Setter Property="IsUndoEnabled" Value="False"/>
            <Setter Property="AllowDrop" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.5"/>
            <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
            <Setter Property="ContextMenu" Value="{StaticResource HelpCopyMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:HelpTextBox">
                        <Border x:Name="PART_ContentHost" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#2A2E37" BorderThickness="0,0,1,0" Padding="10,14,10,14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox x:Name="SearchBox" AutomationProperties.Name="Поиск по справке" TextChanged="OnSearchChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Поиск по справке" Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SectionList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="ArticleScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22,26,26">
                <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="PageSubText" Style="{StaticResource PageSub}" Margin="0,4,0,0"/>
                <ItemsControl x:Name="ArticleList" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Section}" Style="{StaticResource Note}" Margin="0,2,0,0"
                                               Visibility="{Binding ShowSection, Converter={StaticResource BoolVis}}"/>
                                    <ui:HelpTextBox Paragraphs="{Binding Paragraphs}" Margin="-5,8,-5,0" AutomationProperties.Name="{Binding Title}"/>
                                    <ItemsControl ItemsSource="{Binding Pictures}" Margin="0,4,0,2" Visibility="{Binding HasPictures, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border HorizontalAlignment="Left" Margin="0,0,0,8" BorderBrush="#333845" BorderThickness="1" CornerRadius="6" Padding="1"
                                                        Cursor="Hand" ToolTip="Открыть крупно" MouseLeftButtonUp="OnPictureClick">
                                                    <Image Source="{Binding Source}" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="420" MaxWidth="560"
                                                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Name}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding HasLimit, Converter={StaticResource BoolVis}}">
                                        <Run Text="Важно: "/><Run Text="{Binding Limit, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0" Visibility="{Binding HasWhere, Converter={StaticResource BoolVis}}">
                                        <Run Text="Где: "/><Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Keys}" Margin="0,8,0,0" Visibility="{Binding HasKeys, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                               Width="210" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Key}" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSet}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Открыть в настройках" Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Visibility="{Binding HasPage, Converter={StaticResource BoolVis}}" Click="OnOpenSettings"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
