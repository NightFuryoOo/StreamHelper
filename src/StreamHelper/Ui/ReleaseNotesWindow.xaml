<Window x:Class="StreamHelper.Ui.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление" Icon="/app_icon.ico" Width="560" Height="560" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="OnPreviewKeyDown">

    <DockPanel Margin="22,16,22,18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="DateText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="Обновить" Click="OnUpdate"/>
            <Button x:Name="PageButton" Style="{StaticResource FlatButton}" Content="Открыть на GitHub" Margin="8,0,0,0" Click="OnOpenPage"/>
            <Button Style="{StaticResource FlatButton}" Content="Закрыть" Margin="8,0,0,0" Click="OnClose"/>
        </StackPanel>
        <Border Background="#20232B" BorderBrush="#3A3F4B" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0" Padding="4">
            <RichTextBox x:Name="NotesBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" FontSize="14"
                         VerticalScrollBarVisibility="Auto" Padding="8,6" AutomationProperties.Name="Текст обновления"/>
        </Border>
    </DockPanel>
</Window>
