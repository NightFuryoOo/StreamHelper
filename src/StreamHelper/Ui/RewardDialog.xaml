<Window x:Class="StreamHelper.Ui.RewardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Награда за баллы" Icon="/app_icon.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,18,24,20">
        <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" Text="Новая награда"/>

        <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TitleBox" MaxLength="45" AutomationProperties.Name="Название награды"/>

        <TextBlock Text="Цена в баллах" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="CostBox" Width="140" HorizontalAlignment="Left" MaxLength="13" AutomationProperties.Name="Цена в баллах"/>

        <TextBlock Text="Описание для зрителей (необязательно)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PromptBox" MaxLength="200" TextWrapping="Wrap" Height="54" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Описание награды"/>

        <CheckBox x:Name="UserInputCheck" Margin="0,10,0,0" AutomationProperties.Name="Зритель должен написать текст">
            <TextBlock Text="Зритель должен написать текст" TextWrapping="Wrap"/>
        </CheckBox>

        <TextBlock Text="Цвет фона" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
            <TextBox x:Name="ColorBox" DockPanel.Dock="Left" Width="90" MaxLength="7" AutomationProperties.Name="Цвет фона"
                     TextChanged="OnColorChanged"/>
            <Border x:Name="ColorPreview" DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="6" Margin="8,0,0,0"
                    BorderBrush="#3A3F4B" BorderThickness="1"/>
            <WrapPanel x:Name="Swatches" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Text="Ограничения" Style="{StaticResource FieldLabel}"/>
        <DockPanel Margin="0,2,0,0">
            <TextBox x:Name="PerStreamBox" DockPanel.Dock="Right" Width="70" MaxLength="9" AutomationProperties.Name="Сколько раз за стрим"
                     IsEnabled="{Binding IsChecked, ElementName=PerStreamCheck}"/>
            <CheckBox x:Name="PerStreamCheck" VerticalAlignment="Center" AutomationProperties.Name="Не больше раз за стрим">
                <TextBlock Text="Не больше раз за стрим" TextWrapping="Wrap"/>
            </CheckBox>
        </DockPanel>
        <DockPanel Margin="0,6,0,0">
            <TextBox x:Name="PerUserBox" DockPanel.Dock="Right" Width="70" MaxLength="9" AutomationProperties.Name="Сколько раз одному зрителю"
                     IsEnabled="{Binding IsChecked, ElementName=PerUserCheck}"/>
            <CheckBox x:Name="PerUserCheck" VerticalAlignment="Center" AutomationProperties.Name="Не больше раз одному зрителю за стрим">
                <TextBlock Text="Не больше раз одному зрителю за стрим" TextWrapping="Wrap"/>
            </CheckBox>
        </DockPanel>
        <DockPanel Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=CooldownCheck}">
                <TextBox x:Name="CooldownBox" Width="70" MaxLength="7" AutomationProperties.Name="Пауза между заказами"/>
                <RadioButton x:Name="UnitSeconds" Style="{StaticResource TabButton}" GroupName="cooldown" Content="сек" Margin="6,0,0,0" AutomationProperties.Name="секунды"/>
                <RadioButton x:Name="UnitMinutes" Style="{StaticResource TabButton}" GroupName="cooldown" Content="мин" Margin="2,0,0,0" IsChecked="True" AutomationProperties.Name="минуты"/>
                <RadioButton x:Name="UnitHours" Style="{StaticResource TabButton}" GroupName="cooldown" Content="ч" Margin="2,0,0,0" AutomationProperties.Name="часы"/>
            </StackPanel>
            <CheckBox x:Name="CooldownCheck" VerticalAlignment="Center" AutomationProperties.Name="Пауза между заказами">
                <TextBlock Text="Пауза между заказами" TextWrapping="Wrap"/>
            </CheckBox>
        </DockPanel>

        <CheckBox x:Name="SkipQueueCheck" Margin="0,14,0,0" AutomationProperties.Name="Пропускать очередь">
            <TextBlock TextWrapping="Wrap" Text="Пропускать очередь: заказ сразу считается выполненным (удобно для алёртов, «Принять» и «Отклонить» тогда не нужны)"/>
        </CheckBox>
        <CheckBox x:Name="EnabledCheck" Margin="0,10,0,0" IsChecked="True" AutomationProperties.Name="Сразу включить на канале">
            <TextBlock Text="Сразу включить на канале" TextWrapping="Wrap"/>
        </CheckBox>

        <TextBlock x:Name="NoteText" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Иконку Twitch через программу поставить не даёт: у новой награды будет стандартная."/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Создать" Click="OnSave"/>
            <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="8,0,0,0" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
