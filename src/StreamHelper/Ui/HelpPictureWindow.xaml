<Window x:Class="StreamHelper.Ui.HelpPictureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/app_icon.ico" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#1B1D23"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Padding="10">
        <Image x:Name="PictureImage" Stretch="Uniform" StretchDirection="DownOnly" Cursor="Hand" ToolTip="Закрыть: клик или Esc"
               RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonUp="OnPictureClick"/>
    </Border>
</Window>
