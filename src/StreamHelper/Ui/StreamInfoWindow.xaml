<Window x:Class="StreamHelper.Ui.StreamInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Название стрима" Icon="/app_icon.ico" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,18,24,20">
        <TextBlock Text="Название стрима" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="ChannelText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>

        <DockPanel Margin="0,14,0,3">
            <TextBlock x:Name="TitleCounter" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
            <Button x:Name="RecentButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Недавние ▾" Padding="6,1" Margin="0,0,10,0"
                    AutomationProperties.Name="Недавние названия" Click="OnRecentClick"/>
            <TextBlock Text="Название" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="TitleBox" MaxLength="140" TextWrapping="Wrap" AcceptsReturn="False" AutomationProperties.Name="Название стрима"
                 TextChanged="OnTitleChanged"/>

        <TextBlock Text="Категория" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,3"/>
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="26" Height="36" CornerRadius="3" Background="#262A33" Margin="0,0,8,0" ClipToBounds="True">
                <Image x:Name="CategoryArt" Stretch="UniformToFill"/>
            </Border>
            <TextBox x:Name="CategoryBox" VerticalAlignment="Center" AutomationProperties.Name="Категория" TextChanged="OnCategoryTyped"/>
        </DockPanel>
        <Border x:Name="CategoryResults" Background="#20232B" BorderBrush="#3A3F4B" BorderThickness="1" CornerRadius="6" Margin="34,4,0,0" Padding="2"
                Visibility="Collapsed">
            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CategoryList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CategoryButton}" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Name}" Click="OnCategoryPicked">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="20" Height="28" CornerRadius="2" Background="#262A33" Margin="0,0,8,0" ClipToBounds="True">
                                        <Image Source="{Binding BoxArtUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="OnSave"/>
            <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="8,0,0,0" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
