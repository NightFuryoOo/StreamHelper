<Window x:Class="StreamHelper.Ui.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamHelper toast" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13" Opacity="0">

    <Grid>
        <Border x:Name="Root" Background="#F21B1D23" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="LineText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MessageText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                           TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Grid x:Name="ResizeLayer" Visibility="Collapsed">
            <Rectangle Tag="Left" Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,14" Fill="Transparent" Cursor="SizeWE"/>
            <Rectangle Tag="Right" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,14" Fill="Transparent" Cursor="SizeWE"/>
            <Rectangle Tag="Top" Height="8" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="14,0" Fill="Transparent" Cursor="SizeNS"/>
            <Rectangle Tag="Bottom" Height="8" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="14,0" Fill="Transparent" Cursor="SizeNS"/>
            <Rectangle Tag="TopLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNWSE"/>
            <Rectangle Tag="TopRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNESW"/>
            <Rectangle Tag="BottomLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNESW"/>
            <Rectangle Tag="BottomRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNWSE"/>
        </Grid>
    </Grid>
</Window>
