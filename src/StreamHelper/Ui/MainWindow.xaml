<Window x:Class="StreamHelper.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:StreamHelper.Models"
        xmlns:ui="clr-namespace:StreamHelper.Ui"
        Title="StreamHelper" Icon="/app_icon.ico" Width="520" Height="560" MinWidth="500" MinHeight="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <ContextMenu x:Key="CopyMenu" x:Shared="False" Closed="OnCopyMenuClosed">
            <MenuItem Header="Копировать" Command="ApplicationCommands.Copy"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Выделить всё" Command="ApplicationCommands.SelectAll"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <Style x:Key="SelectBox" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="#5A6070" BorderThickness="1.5" CornerRadius="5">
                            <TextBlock x:Name="mark" Text="✓" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Selectable" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="IsUndoEnabled" Value="False"/>
            <Setter Property="AllowDrop" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.5"/>
            <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
            <Setter Property="ContextMenu" Value="{StaticResource CopyMenu}"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="PART_ContentHost" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnSelectableMouseDown"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnSelectableMouseDown"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnSelectableMouseUp"/>
            <EventSetter Event="MouseEnter" Handler="OnSelectableHoverChanged"/>
            <EventSetter Event="MouseLeave" Handler="OnSelectableHoverChanged"/>
        </Style>

        <DataTemplate DataType="{x:Type m:Donation}">
            <Border x:Name="card" Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                    Background="{StaticResource CardBrush}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource SelectBox}" VerticalAlignment="Top" Margin="0,0,10,0"
                                  AutomationProperties.Name="Выбрать" IsChecked="{Binding Selected, Mode=TwoWay}"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="True">
                        <Button x:Name="renameButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="✎"
                                Padding="6,0" Margin="4,0,0,0" FontSize="13" VerticalAlignment="Center"
                                ToolTip="Переименовать" Click="OnRenameClick"/>
                        <Grid>
                            <TextBlock x:Name="nameText" Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                       MouseLeftButtonDown="OnNameMouseDown"/>
                            <TextBox x:Name="nameEdit" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold" Padding="4,1"
                                     Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#323744" Foreground="{StaticResource TextBrush}" CaretBrush="White"
                                     BorderBrush="{StaticResource AccentBrush}" MaxLength="60"
                                     PreviewKeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus"
                                     IsVisibleChanged="OnRenameVisibleChanged"/>
                        </Grid>
                    </DockPanel>
                    <TextBox Style="{StaticResource Selectable}" Grid.Row="0" Grid.Column="1" Text="{Binding AmountText, Mode=OneWay}" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SubText}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBox Style="{StaticResource Selectable}" Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                               Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}"/>

                    <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Удалить"
                                Foreground="{StaticResource DangerBrush}" Click="OnDeleteClick"/>
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Chip}" Content="✓ Посмотрел"
                                      Tag="#4C9AFF" IsChecked="{Binding Seen, Mode=TwoWay}"/>
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Chip}" Content="✓ Сделано"
                                      Tag="#2FA86A" Margin="6,0,0,0" IsChecked="{Binding Done, Mode=TwoWay}"/>
                    </DockPanel>
                </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="nameText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="renameButton" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="nameEdit" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="card" Property="Opacity" Value="0.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="card" Property="Background" Value="#2A3550"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:Follower}">
            <Border x:Name="card" Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                    Background="{StaticResource CardBrush}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource SelectBox}" VerticalAlignment="Top" Margin="0,0,10,0"
                                  AutomationProperties.Name="Выбрать" IsChecked="{Binding Selected, Mode=TwoWay}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="новый фолловер" FontSize="12"
                                   Foreground="{StaticResource AccentBrush}" Margin="10,2,0,0"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TimeText}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Удалить"
                                    Foreground="{StaticResource DangerBrush}" Click="OnDeleteFollowerClick"/>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Chip}" Content="✓ Посмотрел"
                                          Tag="#4C9AFF" IsChecked="{Binding Seen, Mode=TwoWay}"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Seen}" Value="True">
                    <Setter TargetName="card" Property="Opacity" Value="0.7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="card" Property="Background" Value="#2A3550"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:Redemption}">
            <Border x:Name="card" Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                    Background="{StaticResource CardBrush}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource SelectBox}" VerticalAlignment="Top" Margin="0,0,10,0"
                                  AutomationProperties.Name="Выбрать" IsChecked="{Binding Selected, Mode=TwoWay}"
                                  Visibility="{Binding CanSelect, Converter={StaticResource BoolVis}}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Selectable}" Grid.Row="0" Grid.Column="0" Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}"/>
                        <TextBox Style="{StaticResource Selectable}" Grid.Row="0" Grid.Column="1" Text="{Binding CostText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="10,1,0,0"/>
                        <TextBox Style="{StaticResource Selectable}" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding TimeText}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox Style="{StaticResource Selectable}" Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding UserInput, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding HasInput, Converter={StaticResource BoolVis}}"/>
                        <DockPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0" LastChildFill="False"
                                   Visibility="{Binding ShowDelete, Converter={StaticResource BoolVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Удалить"
                                    Foreground="{StaticResource DangerBrush}" Click="OnDeleteRedemptionClick"/>
                        </DockPanel>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding ShowActions, Converter={StaticResource BoolVis}}">
                            <Button Style="{StaticResource PrimaryButton}" Content="Принять" Padding="14,5"
                                    IsEnabled="{Binding CanPress}" Click="OnAcceptRedemptionClick"/>
                            <Button Style="{StaticResource FlatButton}" Content="Отклонить" Margin="6,0,0,0"
                                    Foreground="{StaticResource DangerBrush}" IsEnabled="{Binding CanPress}"
                                    Click="OnRejectRedemptionClick"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                    Visibility="{Binding ShowConfirm, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Отклонить и вернуть баллы зрителю?" Foreground="{StaticResource WarnBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Да, отклонить" Padding="14,5"
                                        Background="{StaticResource DangerBrush}" IsEnabled="{Binding CanPress}"
                                        Click="OnConfirmRejectClick"/>
                                <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="6,0,0,0"
                                        Click="OnCancelRejectClick"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="{Binding StatusText}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                   Visibility="{Binding HasStatusText, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="card" Property="Opacity" Value="0.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="card" Property="Background" Value="#2A3550"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:Subscriber}">
            <Border x:Name="card" Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                    Background="{StaticResource CardBrush}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource SelectBox}" VerticalAlignment="Top" Margin="0,0,10,0"
                                  AutomationProperties.Name="Выбрать" IsChecked="{Binding Selected, Mode=TwoWay}"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding KindText}" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" Margin="10,2,0,0"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SubText}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                               Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}"/>
                    <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Удалить"
                                Foreground="{StaticResource DangerBrush}" Click="OnDeleteSubscriberClick"/>
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Chip}" Content="✓ Посмотрел"
                                      Tag="#4C9AFF" IsChecked="{Binding Seen, Mode=TwoWay}"/>
                    </DockPanel>
                </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Seen}" Value="True">
                    <Setter TargetName="card" Property="Opacity" Value="0.7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="card" Property="Background" Value="#2A3550"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:ChatPing}">
            <Border x:Name="card" Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                    Background="{StaticResource CardBrush}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource SelectBox}" VerticalAlignment="Top" Margin="0,0,10,0"
                                  AutomationProperties.Name="Выбрать" IsChecked="{Binding Selected, Mode=TwoWay}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Style="{StaticResource Selectable}" Grid.Row="0" Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Grid.Row="1" Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox Style="{StaticResource Selectable}" Grid.Row="2" Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap"
                                 Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                 Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}"/>
                        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Удалить"
                                    Foreground="{StaticResource DangerBrush}" Click="OnDeletePingClick"/>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Chip}" Content="✓ Посмотрел"
                                          Tag="#4C9AFF" IsChecked="{Binding Seen, Mode=TwoWay}"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Seen}" Value="True">
                    <Setter TargetName="card" Property="Opacity" Value="0.7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="card" Property="Background" Value="#2A3550"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="5,1,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UnseenCount}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 14,4 L 4,14 M 14,9 L 9,14" Stroke="#66FFFFFF" StrokeThickness="1.5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" Margin="14,8,8,6" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app_logo.png" Width="20" Height="20" Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="{Binding StatusText}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="StreamHelper" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="-6,6,0,0">
                    <RadioButton Style="{StaticResource TabButton}" GroupName="tabs" AutomationProperties.Name="Донаты"
                                 IsChecked="{Binding IsDonationsTab, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Донаты"/>
                            <Border Style="{StaticResource Badge}" DataContext="{Binding Donations}">
                                <TextBlock Text="{Binding UnseenCount}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource TabButton}" GroupName="tabs" Margin="2,0,0,0"
                                 AutomationProperties.Name="Фолловеры" IsChecked="{Binding IsFollowersTab, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Фолловеры"/>
                            <Border Style="{StaticResource Badge}" DataContext="{Binding Followers}">
                                <TextBlock Text="{Binding UnseenCount}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource TabButton}" GroupName="tabs" Margin="2,0,0,0"
                                 AutomationProperties.Name="Подписки" IsChecked="{Binding IsSubscribersTab, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Подписки"/>
                            <Border Style="{StaticResource Badge}" DataContext="{Binding Subscribers}">
                                <TextBlock Text="{Binding UnseenCount}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource TabButton}" GroupName="tabs" Margin="2,0,0,0"
                                 AutomationProperties.Name="Награды" IsChecked="{Binding IsRewardsTab, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Награды"/>
                            <Border Style="{StaticResource Badge}" DataContext="{Binding Redemptions}">
                                <TextBlock Text="{Binding UnseenCount}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource TabButton}" GroupName="tabs" Margin="2,0,0,0"
                                 AutomationProperties.Name="Пинги" IsChecked="{Binding IsPingsTab, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Пинги"/>
                            <Border Style="{StaticResource Badge}" DataContext="{Binding Pings}">
                                <TextBlock Text="{Binding UnseenCount}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </WrapPanel>
                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource FlatButton}" Content="⚙" FontSize="15" Click="OnSettingsClick"
                        ToolTip="Настройки"/>
                <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource FlatButton}" Content="✕" FontSize="14" Click="OnHideClick"
                        ToolTip="Скрыть"/>
            </Grid>

            <ui:UpdateBanner x:Name="UpdateBannerView" Grid.Row="1" Margin="12,0,12,8"/>

            <Grid Grid.Row="2">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDonationsTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,4,0" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Donations.Items}" Margin="0,0,6,6"/>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="10,2,10,8" Padding="6,3" CornerRadius="8" Background="#323744"
                            Visibility="{Binding DonationSelection.HasAny, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{Binding DonationSelection.Count}"
                                    ContentStringFormat="Удалить ({0})"
                                    AutomationProperties.Name="{Binding DonationSelection.Count, StringFormat='Удалить ({0})'}" Foreground="{StaticResource DangerBrush}" Click="OnDeleteSelectedDonationsClick"/>
                            <Button HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Content="{Binding DonationSelection.ToggleAllText}"
                                    Click="OnSelectAllDonationsClick"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.RowSpan="2" Text="{Binding DonationsEmptyText}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="24,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Donations.Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFollowersTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,4,0" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Followers.Items}" Margin="0,0,6,6"/>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="10,2,10,8" Padding="6,3" CornerRadius="8" Background="#323744"
                            Visibility="{Binding FollowerSelection.HasAny, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{Binding FollowerSelection.Count}"
                                    ContentStringFormat="Удалить ({0})"
                                    AutomationProperties.Name="{Binding FollowerSelection.Count, StringFormat='Удалить ({0})'}" Foreground="{StaticResource DangerBrush}" Click="OnDeleteSelectedFollowersClick"/>
                            <Button HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Content="{Binding FollowerSelection.ToggleAllText}"
                                    Click="OnSelectAllFollowersClick"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.RowSpan="2" Text="{Binding FollowersEmptyText}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="24,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Followers.Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSubscribersTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,4,0" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Subscribers.Items}" Margin="0,0,6,6"/>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="10,2,10,8" Padding="6,3" CornerRadius="8" Background="#323744"
                            Visibility="{Binding SubscriberSelection.HasAny, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{Binding SubscriberSelection.Count}"
                                    ContentStringFormat="Удалить ({0})"
                                    AutomationProperties.Name="{Binding SubscriberSelection.Count, StringFormat='Удалить ({0})'}" Foreground="{StaticResource DangerBrush}" Click="OnDeleteSelectedSubscribersClick"/>
                            <Button HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Content="{Binding SubscriberSelection.ToggleAllText}"
                                    Click="OnSelectAllSubscribersClick"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.RowSpan="2" Text="{Binding SubscribersEmptyText}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="24,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Subscribers.Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRewardsTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,4,0" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Redemptions.Items}" Margin="0,0,6,6"/>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="10,2,10,8" Padding="6,3" CornerRadius="8" Background="#323744"
                            IsEnabled="{Binding RewardsIdle}" Visibility="{Binding RewardSelection.HasAny, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <DockPanel Visibility="{Binding ShowRewardsBulkActions, Converter={StaticResource BoolVis}}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="14,5" Content="{Binding RewardSelection.Count}"
                                            ContentStringFormat="Принять ({0})"
                                            AutomationProperties.Name="{Binding RewardSelection.Count, StringFormat='Принять ({0})'}" Click="OnAcceptSelectedRewardsClick"/>
                                    <Button Style="{StaticResource FlatButton}" Margin="6,0,0,0" Content="{Binding RewardSelection.Count}"
                                            ContentStringFormat="Отклонить ({0})"
                                            AutomationProperties.Name="{Binding RewardSelection.Count, StringFormat='Отклонить ({0})'}" Foreground="{StaticResource DangerBrush}"
                                            Click="OnRejectSelectedRewardsClick"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Content="{Binding RewardSelection.ToggleAllText}"
                                        Click="OnSelectAllRewardsClick"/>
                            </DockPanel>
                            <StackPanel Margin="6,3,6,3" Visibility="{Binding ShowRewardsBulkConfirm, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding RewardSelection.Count, StringFormat='Отклонить выбранные ({0}) и вернуть баллы зрителям?'}"
                                           Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Да, отклонить" Padding="14,5"
                                            Background="{StaticResource DangerBrush}" Click="OnConfirmRejectSelectedClick"/>
                                    <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="6,0,0,0"
                                            Click="OnCancelRejectSelectedClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.RowSpan="2" Text="{Binding RewardsEmptyText}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="24,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Redemptions.Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPingsTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,4,0" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Pings.Items}" Margin="0,0,6,6"/>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="10,2,10,8" Padding="6,3" CornerRadius="8" Background="#323744"
                            Visibility="{Binding PingSelection.HasAny, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{Binding PingSelection.Count}"
                                    ContentStringFormat="Удалить ({0})"
                                    AutomationProperties.Name="{Binding PingSelection.Count, StringFormat='Удалить ({0})'}" Foreground="{StaticResource DangerBrush}" Click="OnDeleteSelectedPingsClick"/>
                            <Button HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Content="{Binding PingSelection.ToggleAllText}"
                                    Click="OnSelectAllPingsClick"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.RowSpan="2" Text="{Binding PingsEmptyText}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="24,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pings.Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Grid Grid.Row="3" Margin="12,0,12,10">
                <Border Background="#323744" CornerRadius="8" Padding="12,6"
                        Visibility="{Binding HasUndo, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Вернуть"
                                Foreground="{StaticResource AccentBrush}" Click="OnUndoClick"
                                Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding UndoText}" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </Grid>

            <Thumb Grid.Row="3" Style="{StaticResource ResizeThumb}" Width="18" Height="18"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                   Cursor="SizeNWSE" DragDelta="OnResizeDelta"/>
        </Grid>
    </Border>
</Window>
