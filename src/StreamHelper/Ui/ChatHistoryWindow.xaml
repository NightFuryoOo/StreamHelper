<Window x:Class="StreamHelper.Ui.ChatHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История" Icon="/app_icon.ico" Width="520" Height="620" MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="NickText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <RichTextBox x:Name="Box" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" IsDocumentEnabled="False"
                     Background="#262A33" BorderBrush="#3A3F4B" Foreground="{StaticResource TextBrush}" Padding="8,6"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Сообщения"/>
    </Grid>
</Window>
