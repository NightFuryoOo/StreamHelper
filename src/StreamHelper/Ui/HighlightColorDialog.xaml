<Window x:Class="StreamHelper.Ui.HighlightColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Цвет" Icon="/app_icon.ico" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Подсветка" Foreground="{StaticResource MutedBrush}"/>
        <TextBlock x:Name="NickText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

        <Border Margin="0,14,0,0" Width="312" Height="170" HorizontalAlignment="Left" CornerRadius="3" ClipToBounds="True"
                BorderBrush="#3A3F4B" BorderThickness="1">
            <Grid x:Name="SvArea" Background="Transparent" Cursor="Cross" AutomationProperties.Name="Палитра"
                  MouseLeftButtonDown="OnSvDown" MouseMove="OnSvMove" MouseLeftButtonUp="OnPickerUp" SizeChanged="OnPickerResized">
                <Rectangle x:Name="SvHue" Fill="Red" IsHitTestVisible="False"/>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2"/>
                    <Ellipse x:Name="SvMarkerRing" Width="16" Height="16" Stroke="#99000000" StrokeThickness="1"/>
                </Canvas>
            </Grid>
        </Border>

        <Border Margin="0,10,0,0" Width="312" Height="18" HorizontalAlignment="Left" CornerRadius="3" ClipToBounds="True"
                BorderBrush="#3A3F4B" BorderThickness="1">
            <Grid x:Name="HueArea" Background="Transparent" Cursor="Hand" AutomationProperties.Name="Оттенок"
                  MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnPickerUp" SizeChanged="OnPickerResized">
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0"/>
                            <GradientStop Color="#FFFF00" Offset="0.1667"/>
                            <GradientStop Color="#00FF00" Offset="0.3333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="HueMarker" Width="5" Height="18" Fill="White" Stroke="#99000000" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
                </Canvas>
            </Grid>
        </Border>

        <DockPanel Margin="0,14,0,0">
            <Border x:Name="Preview" DockPanel.Dock="Right" Width="34" Height="34" CornerRadius="6" Margin="12,0,0,0"
                    BorderBrush="#3A3F4B" BorderThickness="1" AutomationProperties.Name="Образец цвета"/>
            <TextBox x:Name="HexBox" MaxLength="7" FontSize="15" AutomationProperties.Name="Цвет" TextChanged="OnHexChanged"/>
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed" Text="Нужен цвет вида #RRGGBB, например #FF9F0A."/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="Выбрать" Click="OnOk"/>
            <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="8,0,0,0" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>