<Window x:Class="StreamHelper.Ui.EmotePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смайлы" Width="400" Height="340" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="#FF181B22" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="SideScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,6,0">
                <StackPanel x:Name="Sidebar" Width="36"/>
            </ScrollViewer>
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                    <TextBox x:Name="EmoteSearch" FontSize="13" Background="#262A33" BorderBrush="#3A3F4B" Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}" Padding="6,4" AutomationProperties.Name="Поиск смайла"
                             TextChanged="OnSearchChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Поиск смайла" FontSize="13" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" Margin="9,4,0,0"/>
                </Grid>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Top" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,0,4,4" Visibility="Collapsed"/>
                <ScrollViewer x:Name="EmoteScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnEmoteScrollChanged">
                    <StackPanel x:Name="Shelves"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
