<Window x:Class="StreamHelper.Ui.ChatOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StreamHelper.Ui"
        Title="StreamHelper — чат" Icon="/app_icon.ico" Width="380" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <Style x:Key="ChatAction" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="1,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="6,1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="CornerGrip" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Visibility" Value="Collapsed"/>

            <EventSetter Event="DragDelta" Handler="OnGripDrag"/>
            <EventSetter Event="DragCompleted" Handler="OnGripCompleted"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#01000000">
                            <Path x:Name="mark" Data="M 4,16 L 16,4 M 9,16 L 16,9 M 14,16 L 16,14" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                  RenderTransformOrigin="0.5,0.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="TopLeft">
                                <Setter TargetName="mark" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Tag" Value="TopRight">
                                <Setter TargetName="mark" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleY="-1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Tag" Value="BottomLeft">
                                <Setter TargetName="mark" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="-1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VoteAction" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#2E3440" BorderBrush="#454C5A" BorderThickness="1" CornerRadius="6" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A4150"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#474F60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VoteBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2.5" Background="#33FFFFFF"/>
                            <Border x:Name="PART_Indicator" CornerRadius="2.5" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComposeIcon" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border x:Name="Panel" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" ClipToBounds="True">
        <Border.Background>
            <SolidColorBrush x:Name="PanelBrush" Color="#101217" Opacity="0.6"/>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ItemsControl x:Name="VoteCards" Grid.Row="0" Margin="8,6,8,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#EE181B22" BorderBrush="#4C9AFF" BorderThickness="1" CornerRadius="8" Padding="10,6,10,8" Margin="0,0,0,4">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#9AA3B2" FontSize="12" Margin="8,1,0,0"/>
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13" Foreground="#E6E8EE" TextWrapping="Wrap"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5,0,0" Opacity="{Binding RowOpacity}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="#9AA3B2" FontSize="12" Margin="8,0,0,0"/>
                                                        <TextBlock Text="{Binding Label}" FontWeight="{Binding Weight}" FontSize="13" Foreground="#E6E8EE"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <ProgressBar Style="{StaticResource VoteBar}" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding BarBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource VoteAction}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Content="{Binding WinText}" AutomationProperties.Name="{Binding WinName}"
                                                        Visibility="{Binding ShowWin, Converter={StaticResource BoolVis}}" Click="OnVoteWin"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Error}" Foreground="#FF5C5C" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding NotBusy}"
                                            Visibility="{Binding ShowButtons, Converter={StaticResource BoolVis}}">
                                    <Button Style="{StaticResource VoteAction}" Content="Завершить" AutomationProperties.Name="Завершить опрос"
                                            Visibility="{Binding ShowEnd, Converter={StaticResource BoolVis}}" Click="OnVoteEnd"/>
                                    <Button Style="{StaticResource VoteAction}" Content="Закрыть ставки" AutomationProperties.Name="Закрыть ставки"
                                            Visibility="{Binding ShowLock, Converter={StaticResource BoolVis}}" Click="OnVoteLock"/>
                                    <Button Style="{StaticResource VoteAction}" Content="{Binding CancelText}" AutomationProperties.Name="{Binding CancelText}"
                                            Visibility="{Binding ShowCancel, Converter={StaticResource BoolVis}}" Click="OnVoteCancel"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid x:Name="Viewport" Grid.Row="1" Margin="10,6,10,6" ClipToBounds="True">
                <StackPanel x:Name="Lines" VerticalAlignment="Bottom"/>
            </Grid>
            <Thumb x:Name="ScrollThumb" Grid.Row="1" Width="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,2,0"
                   Visibility="Collapsed" Cursor="Hand" AutomationProperties.Name="Прокрутка чата"
                   DragDelta="OnScrollThumbDrag">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bar" Background="{StaticResource AccentBrush}" CornerRadius="2.5" Opacity="0.7"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Border x:Name="PausedStrip" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                    Background="#EE181B22" BorderBrush="#4C9AFF" BorderThickness="1" CornerRadius="10" Padding="10,2"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="PausedText" FontSize="12" Foreground="#E6E8EE"/>
            </Border>
            <Border x:Name="MentionBox" Grid.Row="1" VerticalAlignment="Bottom" Margin="10,0,10,4" Background="#FF181B22"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Visibility="Collapsed"
                    AutomationProperties.Name="Кого упомянуть">
                <StackPanel x:Name="MentionList"/>
            </Border>
            <Border x:Name="CopiedStrip" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                    Background="#EE181B22" BorderBrush="#4C9AFF" BorderThickness="1" CornerRadius="10" Padding="10,2"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock FontSize="12" Foreground="#E6E8EE" Text="Скопировано"/>
            </Border>
            <Border x:Name="ComposeBox" Grid.Row="2" Margin="10,0,10,8" Background="#EE181B22" BorderBrush="#3A3F4B" BorderThickness="1"
                    CornerRadius="8" Padding="8,5,8,6" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel x:Name="ReplyBar" Visibility="Collapsed" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource CrossButton}" VerticalAlignment="Center"
                                ToolTip="Не отвечать" AutomationProperties.Name="Не отвечать" Click="OnCancelReply"/>
                        <TextBlock x:Name="ReplyText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel>
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource ComposeIcon}" Margin="2,0,0,0" Visibility="Collapsed"
                                ToolTip="Отправить (Enter)" AutomationProperties.Name="Отправить" Click="OnSendClick">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2.01,21 L23,12 L2.01,3 L2,10 L17,12 L2,14 Z" Fill="{StaticResource AccentBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="EmoteButton" DockPanel.Dock="Right" Style="{StaticResource ComposeIcon}" Margin="6,0,0,0"
                                ToolTip="Смайлы" AutomationProperties.Name="Смайлы" Click="OnEmoteButtonClick">
                            <Canvas Width="18" Height="18">
                                <Ellipse Width="16" Height="16" Canvas.Left="1" Canvas.Top="1" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4"/>
                                <Ellipse Width="2.2" Height="2.2" Canvas.Left="5.6" Canvas.Top="6" Fill="{StaticResource TextBrush}"/>
                                <Ellipse Width="2.2" Height="2.2" Canvas.Left="10.2" Canvas.Top="6" Fill="{StaticResource TextBrush}"/>
                                <Path Data="M5.2,10.6 Q9,14.2 12.8,10.6" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Button>
                    <Grid>
                        <ui:EmoteTextBox x:Name="ComposeText" MaxLength="500" FontSize="14" Background="Transparent" BorderThickness="0" Padding="0,1"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 AutomationProperties.Name="Сообщение в чат" PreviewMouseLeftButtonDown="OnComposeMouseDown"
                                 PreviewKeyDown="OnComposeKeyDown" TextChanged="OnComposeTextChanged"/>
                        <TextBlock x:Name="ComposeHint" Text="Написать в чат…" FontSize="14" LineHeight="24" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource MutedBrush}"
                                   IsHitTestVisible="False" Margin="4,1,0,0"/>
                    </Grid>
                    </DockPanel>
                    <TextBlock x:Name="ComposeError" FontSize="12" Foreground="#FF5C5C" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="PositionLabel" Grid.RowSpan="3" Text="Положение и размер чата" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Thumb x:Name="GripTopLeft" Tag="TopLeft" Grid.RowSpan="3" Style="{StaticResource CornerGrip}" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" AutomationProperties.Name="Растянуть за левый верхний угол"/>
            <Thumb x:Name="GripTopRight" Tag="TopRight" Grid.RowSpan="3" Style="{StaticResource CornerGrip}" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" AutomationProperties.Name="Растянуть за правый верхний угол"/>
            <Thumb x:Name="GripBottomLeft" Tag="BottomLeft" Grid.RowSpan="3" Style="{StaticResource CornerGrip}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" AutomationProperties.Name="Растянуть за левый нижний угол"/>
            <Thumb x:Name="GripBottomRight" Tag="BottomRight" Grid.RowSpan="3" Style="{StaticResource CornerGrip}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" AutomationProperties.Name="Растянуть за правый нижний угол"/>
        </Grid>
    </Border>
    <Border x:Name="ViewersStrip" Grid.Row="1" HorizontalAlignment="Left" Margin="12,3,10,3" Visibility="Collapsed" ToolTip="В эфире">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Viewbox x:Name="ViewersIcon" Width="14" Height="14" VerticalAlignment="Center" Margin="0,1,5,0"/>
            <ui:RollingNumber x:Name="ViewersCount" TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                              TextElement.Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="ViewersDelta" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
    </Grid>
</Window>
