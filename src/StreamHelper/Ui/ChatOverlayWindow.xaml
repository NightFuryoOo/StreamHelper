<Window x:Class="StreamHelper.Ui.ChatOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamHelper — чат" Icon="/app_icon.ico" Width="380" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <Style x:Key="ChatAction" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="1,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="6,1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Panel" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" ClipToBounds="True">
        <Border.Background>
            <SolidColorBrush x:Name="PanelBrush" Color="#101217" Opacity="0.6"/>
        </Border.Background>
        <Grid>
            <Grid x:Name="Viewport" Margin="10,6,10,6" ClipToBounds="True">
                <StackPanel x:Name="Lines" VerticalAlignment="Bottom"/>
            </Grid>
            <TextBlock x:Name="PositionLabel" Text="Положение и размер чата" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Thumb x:Name="Grip" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                   Visibility="Collapsed" DragDelta="OnGripDrag" DragCompleted="OnGripCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Data="M 4,16 L 16,4 M 9,16 L 16,9 M 14,16 L 16,14" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
