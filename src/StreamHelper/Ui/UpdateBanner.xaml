<UserControl x:Class="StreamHelper.Ui.UpdateBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <Border Background="#26314A"
            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8,12,10">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"
                          Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
            </ScrollViewer>
            <TextBlock x:Name="StatusLine" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Обновить" IsEnabled="{Binding NotBusy}" Click="OnUpdate"/>
                <Button Style="{StaticResource FlatButton}" Content="Позже" Margin="8,0,0,0" IsEnabled="{Binding NotBusy}" Click="OnLater"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
