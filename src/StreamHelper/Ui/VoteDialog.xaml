<Window x:Class="StreamHelper.Ui.VoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый опрос" Icon="/app_icon.ico" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,18,24,20">
        <TextBlock x:Name="HeadingText" Text="Новый опрос" FontSize="18" FontWeight="SemiBold"/>

        <DockPanel Margin="0,14,0,3">
            <TextBlock x:Name="TitleCounter" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            <TextBlock Text="Вопрос" Foreground="{StaticResource MutedBrush}"/>
        </DockPanel>
        <TextBox x:Name="TitleBox" AutomationProperties.Name="Вопрос" TextChanged="OnTitleChanged"/>

        <TextBlock x:Name="OptionsLabel" Text="Варианты" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,3"/>
        <ItemsControl x:Name="OptionsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="25"
                                 AutomationProperties.Name="{Binding Name}" TextChanged="OnOptionChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource CrossButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="Убрать" AutomationProperties.Name="{Binding RemoveName}"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolVis}}" Click="OnRemoveOption"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="AddOptionButton" Style="{StaticResource FlatButton}" Content="+ Добавить вариант" HorizontalAlignment="Left"
                Click="OnAddOption"/>

        <TextBlock x:Name="TimeLabel" Text="Длительность" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,3"/>
        <DockPanel>
            <TextBox x:Name="TimeBox" DockPanel.Dock="Left" Width="80" MaxLength="4" FontSize="14"
                     AutomationProperties.Name="Длительность" PreviewTextInput="OnDigitsOnly" DataObject.Pasting="OnDigitsPasting"
                     TextChanged="OnAnyChanged"/>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="UnitSeconds" Style="{StaticResource TabButton}" GroupName="unit" Content="сек" AutomationProperties.Name="секунды"
                             Checked="OnAnyChanged"/>
                <RadioButton x:Name="UnitMinutes" Style="{StaticResource TabButton}" GroupName="unit" Content="мин" Margin="2,0,0,0" IsChecked="True"
                             AutomationProperties.Name="минуты" Checked="OnAnyChanged"/>
            </StackPanel>
        </DockPanel>

        <StackPanel x:Name="PointsPanel" Margin="0,14,0,0">
            <CheckBox x:Name="PointsCheck" Content="Дополнительные голоса за баллы канала" Click="OnPointsToggled"/>
            <StackPanel x:Name="PointsCostPanel" Orientation="Horizontal" Margin="28,6,0,0">
                <TextBox x:Name="PointsBox" Width="100" MaxLength="7" AutomationProperties.Name="Баллов за голос"
                         PreviewTextInput="OnDigitsOnly" DataObject.Pasting="OnDigitsPasting" TextChanged="OnAnyChanged"/>
                <TextBlock Text="баллов за голос" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <Button x:Name="LastResultButton" Style="{StaticResource FlatButton}" Content="Показать результат последнего опроса"
                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnShowLastResult"/>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Начать" Click="OnStart"/>
            <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="8,0,0,0" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
