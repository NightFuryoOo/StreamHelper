                                    <ItemsControl x:Name="PingIgnoredList" ItemTemplate="{StaticResource RemovableChip}" ItemsPanel="{StaticResource WrapItems}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PageRewards" Style="{StaticResource Page}">
                        <TextBlock Text="Награды" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Награды за баллы канала, их звуки и клавиши." Style="{StaticResource PageSub}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Управление наградами" Style="{StaticResource CardTitle}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="RewardCreateButton" Style="{StaticResource PrimaryButton}" Content="Создать награду"
                                            Margin="0,0,8,8" Click="OnCreateRewardClick"/>
                                    <Button x:Name="RewardsSyncButton" Style="{StaticResource SoftButton}" Content="Синхронизировать"
                                            Margin="0,0,8,8" ToolTip="Создать копии наград канала, которыми программа сможет управлять" Click="OnSyncRewards"/>
                                    <Button x:Name="RewardIconsButton" Style="{StaticResource SoftButton}" Content="Сохранить иконки"
                                            Margin="0,0,8,8" ToolTip="Сохранить иконки наград за баллы в папку" Click="OnSaveRewardIcons"/>
                                </WrapPanel>
                                <CheckBox x:Name="OnlyOwnRewardsCheck" Style="{StaticResource SwitchCheck}" Content="Показывать только награды, созданные программой"
                                          Margin="0,4,0,0" Checked="OnOnlyOwnRewardsChanged" Unchecked="OnOnlyOwnRewardsChanged"/>
                                <TextBlock x:Name="RewardsSyncStatus" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                                <TextBlock x:Name="RewardsShowStatus" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <Border x:Name="RewardsShowPanel" Background="#1B1D23" BorderBrush="#2E333E" BorderThickness="1" CornerRadius="8" Padding="12,6,6,8"
                                        Margin="0,8,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="84"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Награда" Style="{StaticResource ColHead}"/>
                                            <TextBlock Grid.Column="1" Text="На канале" Style="{StaticResource ColHead}" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Уведомлять" Style="{StaticResource ColHead}" HorizontalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl x:Name="RewardsShowList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid MinHeight="26" Visibility="{Binding NotConfirming, Converter={StaticResource BoolVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="76"/>
                                                                <ColumnDefinition Width="84"/>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="34"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Button Grid.Column="1" Style="{StaticResource SwitchButton}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Visibility="{Binding CanManage, Converter={StaticResource BoolVis}}" IsEnabled="{Binding NotBusy}"
                                                                    AutomationProperties.Name="{Binding SwitchName}" Click="OnToggleRewardEnabledClick"
                                                                    ToolTip="Включить или выключить награду на канале: выключенную зрители не видят и не могут заказать"/>
                                                            <CheckBox Grid.Column="2" IsChecked="{Binding Shown, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Margin="10,0,0,0" AutomationProperties.Name="{Binding Name}" Click="OnRewardShownClick"
                                                                      ToolTip="Уведомлять и записывать в список «Награды»"/>
                                                            <Button Grid.Column="3" Style="{StaticResource FlatButton}" Padding="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Visibility="{Binding CanManage, Converter={StaticResource BoolVis}}" IsEnabled="{Binding NotBusy}"
                                                                    ToolTip="Изменить награду: название, цена, описание, ограничения" AutomationProperties.Name="{Binding EditName}" Click="OnEditRewardClick">
                                                                <Path Data="M10.5,2.8 L13.2,5.5 L5.6,13.1 L2.6,13.4 L2.9,10.4 Z M9.2,4.1 L11.9,6.8"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                      Width="16" Height="16" Stretch="None"/>
                                                            </Button>
                                                            <Button Grid.Column="4" Style="{StaticResource FlatButton}" Foreground="{StaticResource DangerBrush}" Padding="5"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Visibility="{Binding CanManage, Converter={StaticResource BoolVis}}"
                                                                    ToolTip="Удалить награду с канала" AutomationProperties.Name="{Binding DeleteName}" Click="OnDeleteManagedClick">
                                                                <Path Data="M3.5,5 H12.5 M6.5,5 V3.5 H9.5 V5 M4.8,5 L5.4,13 H10.6 L11.2,5 M7,7.5 V11 M9,7.5 V11"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                      Width="16" Height="16" Stretch="None"/>
                                                            </Button>
                                                        </Grid>
                                                        <StackPanel Margin="0,4,0,4" Visibility="{Binding Confirming, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{Binding ConfirmText}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <Button Style="{StaticResource PrimaryButton}" Content="Да, удалить" Padding="14,5"
                                                                        Background="{StaticResource DangerBrush}" Click="OnConfirmDeleteManaged"/>
                                                                <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="6,0,0,0"
                                                                        Click="OnCancelDeleteManaged"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                           Text="Без «Уведомлять» у награды нет уведомления и записи в списке «Награды», а звук всё равно играет."/>
                                <TextBlock x:Name="RewardsTwitchNote" Style="{StaticResource Note}" Visibility="Collapsed"
                                           Text="Награды, созданные Twitch, нельзя принять или отклонить с помощью программы в меню «Награды»."/>
                                <Button x:Name="DeleteAllButton" Style="{StaticResource SoftButton}" Content="Удалить все копии"
                                        HorizontalAlignment="Left" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0"
                                        Visibility="Collapsed" Click="OnDeleteAllCopies"/>
                                <StackPanel x:Name="DeleteAllPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                    <TextBlock x:Name="DeleteAllText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Да, удалить все" Padding="14,5"
                                                Background="{StaticResource DangerBrush}" Click="OnConfirmDeleteAll"/>
                                        <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="6,0,0,0" Click="OnCancelDeleteAll"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Звук заказа награды" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="RewardSoundListStatus" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                                <ItemsControl x:Name="RewardSoundList" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="rewardsound" Style="{StaticResource TabButton}"
                                                         IsChecked="{Binding Picked, Mode=TwoWay}" Checked="OnRewardSoundPicked"
                                                         AutomationProperties.Name="{Binding Name}">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SoundText}" Margin="14,0,0,0" MaxWidth="220"
                                                               FontWeight="Normal" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding HotkeyText}" Margin="14,0,0,0"
                                                               FontWeight="Normal" Foreground="{StaticResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="RewardSoundAddButton" Style="{StaticResource FlatButton}" Content="+ Добавить награду"
                                        HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                                        Click="OnRewardSoundAddToggle"/>
                                <StackPanel x:Name="RewardSoundAddPanel" Visibility="Collapsed" Margin="0,2,0,0">
                                    <ItemsControl x:Name="RewardSoundAvailableList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="rewardsoundadd" Style="{StaticResource TabButton}" IsChecked="False"
                                                             Checked="OnRewardSoundAddPick" AutomationProperties.Name="{Binding Name}">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="RewardAlertChooseButton" Style="{StaticResource PrimaryButton}" Content="Выбрать файл"
                                            Margin="0,0,8,0" Click="OnRewardAlertChoose"/>
                                    <Button x:Name="RewardAlertTestButton" Style="{StaticResource FlatButton}" Content="Проверить" Margin="0,0,4,0"
                                            Click="OnRewardAlertTest"/>
                                    <Button x:Name="RewardAlertClearButton" Style="{StaticResource FlatButton}" Content="Убрать"
                                            Foreground="{StaticResource DangerBrush}" Click="OnRewardAlertClear"/>
                                </WrapPanel>
                                <TextBlock x:Name="RewardAlertStatus" Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Громкость" VerticalAlignment="Center"/>
                                    <Slider x:Name="RewardAlertVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                            AutomationProperties.Name="Громкость звука заказа" ValueChanged="OnRewardAlertVolumeChanged"/>
                                    <TextBlock x:Name="RewardAlertVolumeText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Клавиша звука" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="8,0,0,0">
                                        <TextBox x:Name="RewardAlertHotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                                 AutomationProperties.Name="Клавиша звука награды"
                                                 PreviewKeyDown="OnRewardHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                                        <Button Style="{StaticResource ResetHotkeyButton}" AutomationProperties.Name="Убрать клавишу звука награды"
                                                Click="OnResetRewardHotkey"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Style="{StaticResource Note}"
                                           Text="Проигрывает звук выбранной награды вручную, даже когда звуки наград выключены. Повторное нажатие запускает звук сначала."/>
                                <TextBlock x:Name="RewardHotkeyHint" Foreground="{StaticResource WarnBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Звуки наград" Style="{StaticResource CardTitle}"/>
                                <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="Клавиша" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                        <Grid Width="150">
                                            <TextBox x:Name="HotkeyRewardSoundsBox" Tag="RewardSoundsMute" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                                     AutomationProperties.Name="Клавиша: звуки наград выкл / вкл" PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                                            <Button Tag="RewardSoundsMute" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                                        </Grid>
                                    </StackPanel>
                                    <CheckBox x:Name="RewardSoundsMutedCheck" Style="{StaticResource SwitchCheck}" Content="Выключить звуки всех наград"
                                              Margin="0,4,0,0" AutomationProperties.Name="Выключить звуки всех наград" Click="OnRewardSoundsMutedClick"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Note}" Text="Пока звуки выключены, в углу экрана виден значок."/>
                                <CheckBox x:Name="MuteRewardsOffCheck" Style="{StaticResource SwitchCheck}" Margin="0,12,0,0"
                                          AutomationProperties.Name="Выключать на это время награды со звуком"
                                          Checked="OnMuteRewardsOffChanged" Unchecked="OnMuteRewardsOffChanged">
                                    <TextBlock TextWrapping="Wrap" Text="Выключать на это время награды со звуком"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource Note}"
                                           Text="Награды из «Звук заказа награды» выключаются на Twitch, пока звуки выключены, и включаются обратно вместе со звуками: зрители их не видят и не тратят баллы. Twitch разрешает это только для наград, созданных программой."/>
                                <TextBlock x:Name="MuteRewardsStatus" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <CheckBox x:Name="MuteBadgeHiddenCheck" Style="{StaticResource SwitchCheck}" Content="Не показывать значок" Margin="0,12,0,0"
                                          AutomationProperties.Name="Выключить отображение иконки" Click="OnMuteBadgeHiddenClick"/>
                                <TextBlock x:Name="MuteBadgeHiddenWarning" Text="Не забывайте включать алёрты назад: с этой настройкой иконки напоминания не будет!"
                                           Foreground="{StaticResource WarnBrush}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Размер значка" VerticalAlignment="Center"/>
                                    <Slider x:Name="MuteBadgeScaleSlider" Grid.Column="1" Minimum="60" Maximum="400" TickFrequency="5"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                            AutomationProperties.Name="Размер значка" ValueChanged="OnMuteBadgeScaleChanged"/>
                                    <TextBlock x:Name="MuteBadgeScaleText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="MuteBadgePositionButton" Style="{StaticResource PrimaryButton}" Content="{x:Static ui:SettingsWindow.PositionText}"
                                            Margin="0,0,8,0" Click="OnMuteBadgePosition"/>
                                    <Button x:Name="MuteBadgeResetButton" Style="{StaticResource FlatButton}" Content="Сбросить положение"
                                            Click="OnMuteBadgeResetPosition"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PageChat" Style="{StaticResource Page}">
                        <TextBlock Text="Чат" Style="{StaticResource PageTitle}"/>
                        <DockPanel Margin="0,6,0,16" LastChildFill="True">
                            <Ellipse x:Name="ChatStatusDot" DockPanel.Dock="Left" Style="{StaticResource StatusDot}"/>
                            <TextBlock x:Name="ChatStatusText" Text="Не подключено" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </DockPanel>

                        <Border x:Name="ChannelBlock" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Канал чата" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0" Text="Чей чат показывать поверх игры. На чужом канале уведомления, подписки и награды не приходят."/>
                                <Border Background="#1B1D23" BorderBrush="#333845" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="ChannelPickerButton" DockPanel.Dock="Right" Style="{StaticResource SoftButton}" VerticalAlignment="Center"
                                                AutomationProperties.Name="Сменить канал" Click="OnToggleChannelPicker">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Сменить канал" VerticalAlignment="Center"/>
                                                <Path Data="M4.5,6.5 L8,10 L11.5,6.5" Width="16" Height="16" Stretch="None" Margin="6,0,-4,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="ChannelPickerChevron" Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </StackPanel>
                                        </Button>
                                        <Border x:Name="CurrentChannelFace" DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="CurrentChannelName" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="#2A2F3A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CurrentChannelKind" FontSize="11" Foreground="#A9AFBC"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="CurrentChannelNote" Style="{StaticResource Note}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock x:Name="ViewerStatusText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"/>

                                <Border x:Name="ChannelPicker" Visibility="Collapsed" Background="#1B1D23" BorderBrush="#333845" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10,12,12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="ChannelRefreshButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Обновить список"
                                                    Margin="8,0,0,0" Click="OnRefreshChannels"/>
                                            <Grid>
                                                <TextBox x:Name="ChannelSearchBox" AutomationProperties.Name="Найти канал" TextChanged="OnChannelSearchChanged"/>
                                                <TextBlock x:Name="ChannelSearchHint" Text="Найти канал" Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0"
                                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            </Grid>
                                        </DockPanel>
                                        <TextBlock Text="Свой канал" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="ChannelChoices"/>
                                        <TextBlock x:Name="ModeratedLabel" Text="Где ты модератор" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="ModeratedChoices"/>
                                        <TextBlock x:Name="ChannelStatusText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"/>
                                        <TextBlock Text="Как зритель" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="ViewerChoices"/>
                                        <DockPanel Margin="0,8,0,0">
                                            <Button x:Name="ViewerAddButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Подключить"
                                                    Margin="8,0,0,0" Click="OnAddViewerChannel"/>
                                            <TextBox x:Name="ViewerChannelInput" AutomationProperties.Name="Ник канала" PreviewKeyDown="OnViewerChannelKeyDown"
                                                     ToolTip="Ник канала или ссылка twitch.tv/…: подключишься к его чату как зритель"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                                   Text="Ник канала или ссылка twitch.tv/…: подключишься к его чату как зритель."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Вид" Style="{StaticResource CardTitle}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Фон чата" VerticalAlignment="Center"/>
                                    <Slider x:Name="ChatOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                            AutomationProperties.Name="Непрозрачность фона чата" ValueChanged="OnChatSliderChanged"/>
                                    <TextBlock x:Name="ChatOpacityText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Подсветка сообщений" VerticalAlignment="Center"/>
                                    <Slider x:Name="ChatCellSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                            AutomationProperties.Name="Непрозрачность плашки сообщений" ValueChanged="OnChatSliderChanged"/>
                                    <TextBlock x:Name="ChatCellText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Обводка сообщений" VerticalAlignment="Center"/>
                                    <Slider x:Name="ChatOutlineSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                            AutomationProperties.Name="Непрозрачность чёрной обводки сообщений" ValueChanged="OnChatSliderChanged"/>
                                    <TextBlock x:Name="ChatOutlineText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Размер текста" VerticalAlignment="Center"/>
                                    <Slider x:Name="ChatFontSlider" Grid.Column="1" Minimum="10" Maximum="28" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                            AutomationProperties.Name="Размер текста чата" ValueChanged="OnChatSliderChanged"/>
                                    <TextBlock x:Name="ChatFontText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Появление сообщений" VerticalAlignment="Center"/>
                                    <Slider x:Name="ChatAppearSlider" Grid.Column="1" Minimum="0" Maximum="1000" TickFrequency="50"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                            AutomationProperties.Name="Плавность появления сообщений" ValueChanged="OnChatAppearChanged"
                                            ToolTip="Сколько длится плавное появление нового сообщения. Влево до упора: сразу, без анимации."/>
                                    <TextBlock x:Name="ChatAppearText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="ChatPositionButton" Style="{StaticResource PrimaryButton}" Content="{x:Static ui:SettingsWindow.PositionText}"
                                            Margin="0,0,8,0" Click="OnChatPosition"/>
                                    <Button Style="{StaticResource FlatButton}" Content="Сбросить положение" Click="OnChatResetPosition"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Клавиши" Style="{StaticResource CardTitle}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Показать / скрыть" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left">
                                        <TextBox x:Name="HotkeyChatToggleBox" Tag="ChatToggle" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                                 AutomationProperties.Name="Клавиша: чат показать / скрыть" PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                                        <Button Tag="ChatToggle" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="Управление мышью" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <Grid Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBox x:Name="HotkeyChatBox" Tag="ChatInteract" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                                 AutomationProperties.Name="Клавиша: чат, управление мышью" PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                                        <Button Tag="ChatInteract" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="Написать сообщение" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <Grid Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBox x:Name="HotkeyChatWriteBox" Tag="ChatWrite" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                                 AutomationProperties.Name="Клавиша: чат, написать сообщение" PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                                        <Button Tag="ChatWrite" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Дополнительно" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="ChatViewersCheck" Style="{StaticResource SwitchCheck}" Margin="0,12,0,0"
                                          AutomationProperties.Name="Показывать число зрителей под чатом" Click="OnChatViewersClick">
                                    <TextBlock TextWrapping="Wrap" Text="Показывать число зрителей под чатом"/>
                                </CheckBox>
                                <CheckBox x:Name="ChatPreviewsCheck" Style="{StaticResource SwitchCheck}" Margin="0,10,0,0"
                                          AutomationProperties.Name="Показывать превью клипов Twitch и видео YouTube" Click="OnChatPreviewsClick">
                                    <TextBlock TextWrapping="Wrap" Text="Показывать превью клипов Twitch и видео YouTube"/>
                                </CheckBox>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Мут кнопкой в чате на" VerticalAlignment="Center"/>
                                    <Slider x:Name="ChatMuteSlider" Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                            AutomationProperties.Name="Длительность мута" ValueChanged="OnChatMuteChanged"/>
                                    <TextBlock x:Name="ChatMuteText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <TextBlock x:Name="ChatModerationText" Foreground="{StaticResource WarnBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PageGeneral" Style="{StaticResource Page}">
                        <TextBlock Text="Общие" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Клавиши вкладок, чата и звуков стоят рядом с ними: в «Событиях», «Чате» и «Наградах»."
                                   Style="{StaticResource PageSub}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Клавиши программы" Style="{StaticResource CardTitle}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Открыть настройки" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left">
                                        <TextBox x:Name="HotkeySettingsBox" Tag="Settings" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                                 AutomationProperties.Name="Клавиша: настройки" PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                                        <Button Tag="Settings" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="Скрыть уведомления" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <Grid Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBox x:Name="HotkeyHideToastsBox" Tag="HideToasts" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                                 AutomationProperties.Name="Клавиша: скрыть уведомления" PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                                        <Button Tag="HideToasts" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Профиль" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Note}" Text="Все настройки в одном файле: перенести на другой компьютер или сохранить копию."/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Сохранить профиль" Margin="0,0,8,0" Click="OnSaveProfile"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Загрузить профиль" Click="OnLoadProfile"/>
                                </WrapPanel>
                                <CheckBox x:Name="ProfileListsCheck" Style="{StaticResource SwitchCheck}" Content="Включить списки (донаты, заказы наград и т.д.)"
                                          Margin="0,12,0,0"/>
                                <StackPanel x:Name="ProfileConfirmPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <TextBlock x:Name="ProfileConfirmText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Загрузить и перезапустить" Padding="14,5"
                                                Click="OnConfirmLoadProfile"/>
                                        <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="6,0,0,0" Click="OnCancelLoadProfile"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="ProfileStatus" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <Button x:Name="ProfileShowFileButton" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Visibility="Collapsed" Click="OnShowProfileFile"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <DockPanel x:Name="VersionBlock" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Выбрать версию…" VerticalAlignment="Center"
                                        Click="OnChooseVersion"/>
                                <StackPanel>
                                    <TextBlock Text="Версия программы" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding CurrentText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding AvailableText}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,2,0,0"
                                               Visibility="{Binding HasAvailable, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <Border x:Name="CreditsBar" Grid.Row="1" Grid.ColumnSpan="2" Padding="16,4,8,4" BorderBrush="#3A3F4B" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="4" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Свернуть" AutomationProperties.Name="Свернуть подпись" Click="OnCollapseCredits">
                    <Path Data="M4.5,6.5 L8,10 L11.5,6.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="None"/>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}" Padding="5" Margin="2,0,0,0" Tag="https://github.com/NightFuryoOo/StreamHelper" ToolTip="https://github.com/NightFuryoOo/StreamHelper"
                            AutomationProperties.Name="GitHub" Click="OnOpenLink">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" Fill="#E6E8EE"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Padding="5" Margin="2,0,0,0" Tag="https://www.twitch.tv/nightfuryo3o" ToolTip="https://www.twitch.tv/nightfuryo3o"
                            AutomationProperties.Name="Twitch" Click="OnOpenLink">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z" Fill="#A970FF"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Padding="5" Margin="2,0,0,0" Tag="https://t.me/+kiK_3CQ8MlAxNzUy" ToolTip="https://t.me/+kiK_3CQ8MlAxNzUy"
                            AutomationProperties.Name="Telegram" Click="OnOpenLink">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" Fill="#26A5E4"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Padding="5" Margin="2,0,0,0" Tag="https://www.donationalerts.com/r/nightfuryo3o" ToolTip="https://www.donationalerts.com/r/nightfuryo3o"
                            AutomationProperties.Name="DonationAlerts" Click="OnOpenLink">
                        <Image Source="/Assets/donationalerts.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}">
                    <Run Text="Разработчик"/> <Run Text="NightFuryo3o" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                </TextBlock>
            </DockPanel>
        </Border>
        <Border x:Name="CreditsHandle" Grid.Row="1" Grid.ColumnSpan="2" Padding="0,1,8,1" BorderBrush="#3A3F4B" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <Button Style="{StaticResource FlatButton}" Padding="6,1" HorizontalAlignment="Right"
                    ToolTip="Показать подпись разработчика" AutomationProperties.Name="Развернуть подпись" Click="OnExpandCredits">
                <Path Data="M4.5,9.5 L8,6 L11.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="14" Stretch="None"/>
            </Button>
        </Border>
    </Grid>
</Window>
