<Window x:Class="StreamHelper.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StreamHelper.Ui"
        Title="StreamHelper — настройки" Icon="/app_icon.ico" Width="560" Height="700" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>

        <Style x:Key="ResetHotkeyButton" TargetType="Button" BasedOn="{StaticResource CrossButton}">
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Сбросить"/>
            <Setter Property="AutomationProperties.Name" Value="Сбросить"/>
        </Style>
        <DataTemplate x:Key="RemovableChip">
            <Border Background="{StaticResource CardBrush}" CornerRadius="13" Padding="10,2,3,2" Margin="0,6,6,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    <Button Style="{StaticResource CrossButton}" Margin="2,0,0,0" VerticalAlignment="Center"
                            ToolTip="Убрать" AutomationProperties.Name="{Binding RemoveName}" Click="OnRemoveEntry"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel/>
        </ItemsPanelTemplate>
        <Style x:Key="SwitchButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" Width="40" Height="22">
                            <Border x:Name="track" Width="34" Height="18" CornerRadius="9" Background="#3A3F4B"/>
                            <Ellipse x:Name="knob" Width="14" Height="14" Fill="#C9CDD6" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="knob" Property="Fill" Value="White"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,5,0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="track" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="knob" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>

        <Style x:Key="ServiceTile" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="82"/>
            <Setter Property="Margin" Value="0,10,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#262A33" BorderBrush="#3A3F4B" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#2B303B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B7BDCB"/>
            <Setter Property="Background" Value="#323744"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,6,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="22,16,22,16"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,10,14,8" BorderBrush="#3A3F4B" BorderThickness="0,0,0,1">
            <WrapPanel>
                <RadioButton x:Name="TabGeneral" Style="{StaticResource TabButton}" GroupName="sections" Tag="0"
                             Content="Общие" AutomationProperties.Name="Общие" Checked="OnSectionChecked"/>
                <RadioButton x:Name="TabDonations" Style="{StaticResource TabButton}" GroupName="sections" Tag="1" Margin="2,0,0,0"
                             Content="Донаты" AutomationProperties.Name="Донаты" Checked="OnSectionChecked"/>
                <RadioButton x:Name="TabTwitch" Style="{StaticResource TabButton}" GroupName="sections" Tag="2" Margin="2,0,0,0"
                             Content="Twitch" AutomationProperties.Name="Twitch" Checked="OnSectionChecked"/>
                <RadioButton x:Name="TabFollowers" Style="{StaticResource TabButton}" GroupName="sections" Tag="3" Margin="2,0,0,0"
                             Content="Фолловеры" AutomationProperties.Name="Фолловеры" Checked="OnSectionChecked"/>
                <RadioButton x:Name="TabSubscribers" Style="{StaticResource TabButton}" GroupName="sections" Tag="4" Margin="2,0,0,0"
                             Content="Подписки" AutomationProperties.Name="Подписки" Checked="OnSectionChecked"/>
                <RadioButton x:Name="TabRewards" Style="{StaticResource TabButton}" GroupName="sections" Tag="5" Margin="2,0,0,0"
                             Content="Награды" AutomationProperties.Name="Награды" Checked="OnSectionChecked"/>
                <RadioButton x:Name="TabPings" Style="{StaticResource TabButton}" GroupName="sections" Tag="6" Margin="2,0,0,0"
                             Content="Пинги" AutomationProperties.Name="Пинги" Checked="OnSectionChecked"/>
                <RadioButton x:Name="TabMoments" Style="{StaticResource TabButton}" GroupName="sections" Tag="8" Margin="2,0,0,0"
                             Content="Рейды и стрики" AutomationProperties.Name="Рейды и стрики" Checked="OnSectionChecked"/>
                <RadioButton x:Name="TabChat" Style="{StaticResource TabButton}" GroupName="sections" Tag="7" Margin="2,0,0,0"
                             Content="Чат" AutomationProperties.Name="Чат" Checked="OnSectionChecked"/>
            </WrapPanel>
        </Border>

        <ui:UpdateBanner x:Name="UpdateBannerView" Grid.Row="1" Margin="14,10,14,0"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>

                <StackPanel x:Name="SectionGeneral" Style="{StaticResource SectionPanel}">
                    <TextBlock Text="Горячие клавиши" Style="{StaticResource Heading}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Донаты" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <Grid Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,0">
                            <TextBox x:Name="HotkeyDonationsBox" Tag="Donations" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="Donations" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Фолловеры" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Grid Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBox x:Name="HotkeyFollowersBox" Tag="Followers" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="Followers" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="Подписки" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Grid Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBox x:Name="HotkeySubscribersBox" Tag="Subscribers" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="Subscribers" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                        <TextBlock Grid.Row="3" Text="Награды" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Grid Grid.Row="3" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBox x:Name="HotkeyRewardsBox" Tag="Rewards" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="Rewards" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                        <TextBlock Grid.Row="4" Text="Пинги" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Grid Grid.Row="4" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBox x:Name="HotkeyPingsBox" Tag="Pings" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="Pings" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                        <TextBlock Grid.Row="5" Text="Рейды и стрики" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Grid Grid.Row="5" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBox x:Name="HotkeyMomentsBox" Tag="Moments" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="Moments" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                        <TextBlock Grid.Row="6" Text="Настройки" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Grid Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBox x:Name="HotkeySettingsBox" Tag="Settings" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="Settings" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                        <TextBlock Grid.Row="7" Text="Скрыть уведомления" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Grid Grid.Row="7" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBox x:Name="HotkeyHideToastsBox" Tag="HideToasts" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="HideToasts" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                        <TextBlock Grid.Row="8" Text="Чат: управление мышью" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Grid Grid.Row="8" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBox x:Name="HotkeyChatBox" Tag="ChatInteract" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="ChatInteract" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                        <TextBlock Grid.Row="9" Text="Чат: показать / скрыть" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Grid Grid.Row="9" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBox x:Name="HotkeyChatToggleBox" Tag="ChatToggle" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="ChatToggle" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                        <TextBlock Grid.Row="10" Text="Звуки наград: выкл / вкл" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Grid Grid.Row="10" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBox x:Name="HotkeyRewardSoundsBox" Tag="RewardSoundsMute" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="6,5,28,5"
                                     PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp"/>
                            <Button Tag="RewardSoundsMute" Style="{StaticResource ResetHotkeyButton}" Click="OnResetHotkey"/>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="HotkeyHint" Foreground="{StaticResource WarnBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <Separator Margin="0,12,0,10" Background="#3A3F4B"/>

                    <TextBlock Text="Окно уведомления" Style="{StaticResource Heading}"/>
                    <CheckBox x:Name="ToastCheck" Content="Всплывающее уведомление, когда окно скрыто" Margin="0,10,0,0" Click="OnOptionsChanged"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Прозрачность" VerticalAlignment="Center"/>
                        <Slider x:Name="ToastOpacitySlider" Grid.Column="1" Minimum="20" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="Прозрачность уведомления" ValueChanged="OnToastSliderChanged"/>
                        <TextBlock x:Name="ToastOpacityText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Размер" VerticalAlignment="Center"/>
                        <Slider x:Name="ToastScaleSlider" Grid.Column="1" Minimum="60" Maximum="200" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="Размер уведомления" ValueChanged="OnToastSliderChanged"/>
                        <TextBlock x:Name="ToastScaleText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Время показа" VerticalAlignment="Center"/>
                        <Slider x:Name="ToastSecondsSlider" Grid.Column="1" Minimum="2" Maximum="60" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="Время показа уведомления" ValueChanged="OnToastSliderChanged"/>
                        <TextBlock x:Name="ToastSecondsText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Показать пример" Click="OnToastSample"/>
                        <Button x:Name="ToastPositionButton" Style="{StaticResource PrimaryButton}" Content="Выбрать положение"
                                Margin="8,0,0,0" Click="OnToastPosition"/>
                        <Button Style="{StaticResource FlatButton}" Content="Сбросить положение" Margin="8,0,0,0"
                                Click="OnToastResetPosition"/>
                    </StackPanel>

                    <Separator Margin="0,12,0,10" Background="#3A3F4B"/>

                    <StackPanel x:Name="VersionBlock">
                        <TextBlock Text="Версия программы" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{Binding CurrentText}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding AvailableText}" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding HasAvailable, Converter={StaticResource BoolVis}}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Выбрать версию…" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="OnChooseVersion"/>
                    </StackPanel>

                    <Separator Margin="0,12,0,10" Background="#3A3F4B"/>

                    <TextBlock Text="Профиль" Style="{StaticResource Heading}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Сохранить профиль" Click="OnSaveProfile"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Загрузить профиль" Margin="8,0,0,0" Click="OnLoadProfile"/>
                    </StackPanel>
                    <CheckBox x:Name="ProfileListsCheck" Content="Включить списки (донаты, заказы наград и т.д.)" Margin="0,10,0,0"/>
                    <StackPanel x:Name="ProfileConfirmPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="ProfileConfirmText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Загрузить и перезапустить" Padding="14,5"
                                    Click="OnConfirmLoadProfile"/>
                            <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="6,0,0,0" Click="OnCancelLoadProfile"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="ProfileStatus" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <Button x:Name="ProfileShowFileButton" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Visibility="Collapsed" Click="OnShowProfileFile"/>

                </StackPanel>

                <StackPanel x:Name="SectionDonations" Style="{StaticResource SectionPanel}">
                    <WrapPanel>
                        <Button x:Name="TileDonationAlerts" Style="{StaticResource ServiceTile}" Tag="DonationAlerts" Click="OnServiceTileClick"
                                AutomationProperties.Name="DonationAlerts">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image x:Name="LogoDonationAlerts" Source="/Assets/donationalerts.png" Width="36" Height="36" Opacity="0.45"
                                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                                    <TextBlock Text="DonationAlerts" Margin="0,7,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                                <Border x:Name="BadgeDonationAlerts" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed">
                                    <TextBlock x:Name="MarkDonationAlerts" Text="✓" Foreground="White" FontWeight="Bold" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="TileDonatePay" Style="{StaticResource ServiceTile}" Tag="DonatePay" Click="OnServiceTileClick"
                                AutomationProperties.Name="DonatePay">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image x:Name="LogoDonatePay" Source="/Assets/donatepay.png" Width="36" Height="36" Opacity="0.45"
                                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                                    <TextBlock Text="DonatePay" Margin="0,7,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                                <Border x:Name="BadgeDonatePay" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed">
                                    <TextBlock x:Name="MarkDonatePay" Text="✓" Foreground="White" FontWeight="Bold" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="TileDonateX" Style="{StaticResource ServiceTile}" Tag="DonateX" Click="OnServiceTileClick"
                                AutomationProperties.Name="DonateX">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image x:Name="LogoDonateX" Source="/Assets/donatex.png" Width="36" Height="36" Opacity="0.45"
                                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                                    <TextBlock Text="DonateX" Margin="0,7,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                                <Border x:Name="BadgeDonateX" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed">
                                    <TextBlock x:Name="MarkDonateX" Text="✓" Foreground="White" FontWeight="Bold" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                    </WrapPanel>

                    <Button Style="{StaticResource SoftButton}" Content="Тестовый донат" HorizontalAlignment="Left" Margin="0,12,0,0"
                            AutomationProperties.Name="Добавить тестовый донат" Click="OnAddTestDonation"/>
                </StackPanel>

                <StackPanel x:Name="SectionTwitch" Style="{StaticResource SectionPanel}">
                    <TextBlock Text="Twitch" Style="{StaticResource Heading}"/>

                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Ellipse x:Name="TwitchStatusDot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                 Margin="0,4,8,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TwitchStatusText" Text="Twitch не подключён." TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock x:Name="TwitchRightsText" Foreground="{StaticResource WarnBrush}" Margin="17,4,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="TwitchCodePanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Код для подтверждения на странице Twitch" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TwitchCodeBox" IsReadOnly="True" FontSize="18" FontWeight="SemiBold" Width="170"/>
                            <Button Style="{StaticResource FlatButton}" Content="Копировать" Margin="8,0,0,0" Click="OnCopyTwitchCode"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="TwitchConnectButton" Style="{StaticResource PrimaryButton}" Content="Подключить Twitch"
                                Click="OnTwitchConnect"/>
                        <Button Style="{StaticResource FlatButton}" Content="Отключить" Margin="8,0,0,0" Click="OnTwitchDisconnect"/>
                    </StackPanel>

                    <StackPanel x:Name="ChannelBlock" Margin="0,18,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="ChannelRefreshButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Обновить список"
                                    Padding="8,0" Click="OnRefreshChannels"/>
                            <TextBlock Text="Канал" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel x:Name="ChannelChoices" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ChannelStatusText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="На канале, где ты модератор, работают чат поверх игры, бан и мут, «Отметить», пинги, рейды и стрики и фолловеры. Подписки, награды за баллы, опросы и предикты остаются только на своём канале."/>
                    </StackPanel>

                </StackPanel>

                <StackPanel x:Name="SectionFollowers" Style="{StaticResource SectionPanel}">
                    <TextBlock Text="Фолловеры" Style="{StaticResource Heading}"/>

                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Тест" MinWidth="0" Padding="10,1"
                                VerticalAlignment="Center" Margin="8,-3,0,-3" ToolTip="Добавить тестового фолловера" AutomationProperties.Name="Добавить тестового фолловера" Click="OnAddTestFollower"/>
                        <Ellipse x:Name="FollowersStatusDot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FollowersStatusText" Text="Фолловеры: не подключено" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>

                    <CheckBox x:Name="FollowersCheck" Margin="0,10,0,0" Click="OnOptionsChanged"
                              AutomationProperties.Name="Уведомлять о новых фолловерах">
                        <TextBlock TextWrapping="Wrap" Text="Уведомлять о новых фолловерах"/>
                    </CheckBox>
                </StackPanel>

                <StackPanel x:Name="SectionSubscribers" Style="{StaticResource SectionPanel}">
                    <TextBlock Text="Подписки" Style="{StaticResource Heading}"/>

                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Тест" MinWidth="0" Padding="10,1"
                                VerticalAlignment="Center" Margin="8,-3,0,-3" ToolTip="Добавить тестовую подписку" AutomationProperties.Name="Добавить тестовую подписку" Click="OnAddTestSubscriber"/>
                        <Ellipse x:Name="SubsStatusDot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SubsStatusText" Text="Подписки: не подключено" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>

                    <CheckBox x:Name="SubscribersCheck" Margin="0,10,0,0" Click="OnOptionsChanged"
                              AutomationProperties.Name="Уведомлять о новых подписках">
                        <TextBlock TextWrapping="Wrap" Text="Уведомлять о новых подписках"/>
                    </CheckBox>
                </StackPanel>

                <StackPanel x:Name="SectionRewards" Style="{StaticResource SectionPanel}">
                    <TextBlock Text="Награды за баллы канала" Style="{StaticResource Heading}"/>

                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Тест" MinWidth="0" Padding="10,1"
                                VerticalAlignment="Center" Margin="8,-3,0,-3" ToolTip="Добавить тестовую награду" AutomationProperties.Name="Добавить тестовую награду" Click="OnAddTestRedemption"/>
                        <Ellipse x:Name="RewardsStatusDot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RewardsStatusText" Text="Награды: не подключено" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>

                    <CheckBox x:Name="RewardsCheck" Margin="0,10,0,0" Click="OnOptionsChanged"
                              AutomationProperties.Name="Уведомлять о наградах за баллы">
                        <TextBlock TextWrapping="Wrap" Text="Уведомлять о наградах за баллы"/>
                    </CheckBox>

                    <Separator Margin="0,12,0,10" Background="#3A3F4B"/>

                    <TextBlock Text="Управление наградами" Style="{StaticResource Heading}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="RewardsSyncButton" Style="{StaticResource PrimaryButton}" Content="Синхронизировать награды"
                                Click="OnSyncRewards"/>
                        <Button x:Name="RewardIconsButton" Style="{StaticResource PrimaryButton}" Content="Сохранить иконки наград за баллы"
                                Margin="8,0,0,0" Click="OnSaveRewardIcons"/>
                    </StackPanel>
                    <TextBlock x:Name="RewardsSyncStatus" Style="{StaticResource Label}" Margin="0,8,0,0"/>

                    <CheckBox x:Name="OnlyOwnRewardsCheck" Content="Показывать только награды, созданные программой" Margin="0,10,0,0"
                              Checked="OnOnlyOwnRewardsChanged" Unchecked="OnOnlyOwnRewardsChanged"/>
                    <TextBlock Text="Без галочки у награды нет уведомления и записи в списке «Награды», звук алёрта будет проигрываться." Foreground="{StaticResource MutedBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RewardsTwitchNote" Text="Награды, созданные Twitch, нельзя принять или отклонить с помощью программы в меню «Награды»."
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="RewardsShowStatus" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <Border x:Name="RewardsShowPanel" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12,6,6,8"
                            Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Награда" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="На канале" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Уведомлять" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                            </Grid>
                            <ItemsControl x:Name="RewardsShowList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,0">
                                            <Grid MinHeight="26" Visibility="{Binding NotConfirming, Converter={StaticResource BoolVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <DockPanel Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding Renaming, Converter={StaticResource BoolVis}}">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource CrossButton}" Margin="2,0,0,0" VerticalAlignment="Center"
                                                            ToolTip="Отмена (Esc)" AutomationProperties.Name="Отменить переименование" Click="OnCancelRenameReward"/>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="3" Margin="4,0,0,0" VerticalAlignment="Center"
                                                            IsEnabled="{Binding NotBusy}" ToolTip="Сохранить (Enter)" AutomationProperties.Name="Сохранить название" Click="OnConfirmRenameReward">
                                                        <Path Data="M3,8.5 L6.5,12 L13,4.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Width="16" Height="16" Stretch="None"/>
                                                    </Button>
                                                    <TextBox Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="45" Padding="4,2"
                                                             IsEnabled="{Binding NotBusy}" AutomationProperties.Name="Новое название награды"
                                                             PreviewKeyDown="OnRenameRewardKeyDown" IsVisibleChanged="OnRenameRewardBoxVisible"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"
                                                           Visibility="{Binding NotRenaming, Converter={StaticResource BoolVis}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="1" Style="{StaticResource SwitchButton}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding CanManage, Converter={StaticResource BoolVis}}" IsEnabled="{Binding NotBusy}"
                                                        AutomationProperties.Name="{Binding SwitchName}" Click="OnToggleRewardEnabledClick"
                                                        ToolTip="Включить или выключить награду на канале: выключенную зрители не видят и не могут заказать"/>
                                                <CheckBox Grid.Column="2" IsChecked="{Binding Shown, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Margin="10,0,0,0" AutomationProperties.Name="{Binding Name}" Click="OnRewardShownClick"
                                                          ToolTip="Уведомлять и записывать в список «Награды»"/>
                                                <Button Grid.Column="3" Style="{StaticResource FlatButton}" Padding="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding CanManage, Converter={StaticResource BoolVis}}" IsEnabled="{Binding NotBusy}"
                                                        ToolTip="Переименовать награду на канале" AutomationProperties.Name="{Binding RenameName}" Click="OnRenameRewardClick">
                                                    <Path Data="M10.5,2.8 L13.2,5.5 L5.6,13.1 L2.6,13.4 L2.9,10.4 Z M9.2,4.1 L11.9,6.8"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="16" Height="16" Stretch="None"/>
                                                </Button>
                                                <Button Grid.Column="4" Style="{StaticResource FlatButton}" Foreground="{StaticResource DangerBrush}" Padding="5"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding CanManage, Converter={StaticResource BoolVis}}"
                                                        ToolTip="Удалить награду с канала" AutomationProperties.Name="{Binding DeleteName}" Click="OnDeleteManagedClick">
                                                    <Path Data="M3.5,5 H12.5 M6.5,5 V3.5 H9.5 V5 M4.8,5 L5.4,13 H10.6 L11.2,5 M7,7.5 V11 M9,7.5 V11"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="16" Height="16" Stretch="None"/>
                                                </Button>
                                            </Grid>
                                            <StackPanel Margin="0,4,0,4" Visibility="{Binding Confirming, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding ConfirmText}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Да, удалить" Padding="14,5"
                                                            Background="{StaticResource DangerBrush}" Click="OnConfirmDeleteManaged"/>
                                                    <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="6,0,0,0"
                                                            Click="OnCancelDeleteManaged"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Button x:Name="DeleteAllButton" Style="{StaticResource SoftButton}" Content="Удалить все копии"
                            HorizontalAlignment="Left" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0"
                            Visibility="Collapsed" Click="OnDeleteAllCopies"/>
                    <StackPanel x:Name="DeleteAllPanel" Visibility="Collapsed" Margin="0,6,0,0">
                        <TextBlock x:Name="DeleteAllText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Да, удалить все" Padding="14,5"
                                    Background="{StaticResource DangerBrush}" Click="OnConfirmDeleteAll"/>
                            <Button Style="{StaticResource FlatButton}" Content="Отмена" Margin="6,0,0,0" Click="OnCancelDeleteAll"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,12,0,10" Background="#3A3F4B"/>

                    <TextBlock Text="Звук заказа награды" Style="{StaticResource Heading}"/>
                    <TextBlock x:Name="RewardSoundListStatus" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <ItemsControl x:Name="RewardSoundList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="rewardsound" Style="{StaticResource TabButton}"
                                             IsChecked="{Binding Picked, Mode=TwoWay}" Checked="OnRewardSoundPicked"
                                             AutomationProperties.Name="{Binding Name}">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SoundText}" Margin="14,0,0,0" MaxWidth="220"
                                                   FontWeight="Normal" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="RewardSoundAddButton" Style="{StaticResource FlatButton}" Content="+ Добавить награду"
                            HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                            Click="OnRewardSoundAddToggle"/>
                    <StackPanel x:Name="RewardSoundAddPanel" Visibility="Collapsed" Margin="0,2,0,0">
                        <ItemsControl x:Name="RewardSoundAvailableList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="rewardsoundadd" Style="{StaticResource TabButton}" IsChecked="False"
                                                 Checked="OnRewardSoundAddPick" AutomationProperties.Name="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="RewardAlertChooseButton" Style="{StaticResource PrimaryButton}" Content="Выбрать файл"
                                Click="OnRewardAlertChoose"/>
                        <Button x:Name="RewardAlertTestButton" Style="{StaticResource FlatButton}" Content="Проверить" Margin="8,0,0,0"
                                Click="OnRewardAlertTest"/>
                        <Button x:Name="RewardAlertClearButton" Style="{StaticResource FlatButton}" Content="Убрать" Margin="4,0,0,0"
                                Foreground="{StaticResource DangerBrush}" Click="OnRewardAlertClear"/>
                    </StackPanel>
                    <TextBlock x:Name="RewardAlertStatus" Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Громкость" VerticalAlignment="Center"/>
                        <Slider x:Name="RewardAlertVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="Громкость звука заказа" ValueChanged="OnRewardAlertVolumeChanged"/>
                        <TextBlock x:Name="RewardAlertVolumeText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <Separator Margin="0,12,0,10" Background="#3A3F4B"/>

                    <TextBlock Text="Звуки наград" Style="{StaticResource Heading}"/>
                    <CheckBox x:Name="RewardSoundsMutedCheck" Content="Выключить звуки всех наград" Margin="0,10,0,0"
                              AutomationProperties.Name="Выключить звуки всех наград" Click="OnRewardSoundsMutedClick"/>
                    <TextBlock Text="Пока звуки выключены, в углу экрана виден значок. Клавиша — на вкладке «Общие»."
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <CheckBox x:Name="MuteRewardsOffCheck" Margin="0,10,0,0" AutomationProperties.Name="Выключать на это время награды со звуком"
                              Checked="OnMuteRewardsOffChanged" Unchecked="OnMuteRewardsOffChanged">
                        <TextBlock TextWrapping="Wrap" Text="Выключать на это время награды со звуком"/>
                    </CheckBox>
                    <TextBlock Text="Награды из списка «Звук заказа награды» выше выключаются на Twitch, пока звуки выключены, и включаются обратно вместе со звуками: зрители их не видят и не тратят баллы. Twitch разрешает это только для наград, созданных программой."
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MuteRewardsStatus" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <CheckBox x:Name="MuteBadgeHiddenCheck" Content="Выключить отображение иконки" Margin="0,10,0,0"
                              AutomationProperties.Name="Выключить отображение иконки" Click="OnMuteBadgeHiddenClick"/>
                    <TextBlock x:Name="MuteBadgeHiddenWarning" Text="Не забывайте включать алёрты назад: с этой настройкой иконки напоминания не будет!"
                               Foreground="{StaticResource WarnBrush}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Размер значка" VerticalAlignment="Center"/>
                        <Slider x:Name="MuteBadgeScaleSlider" Grid.Column="1" Minimum="60" Maximum="400" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="Размер значка" ValueChanged="OnMuteBadgeScaleChanged"/>
                        <TextBlock x:Name="MuteBadgeScaleText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="MuteBadgePositionButton" Style="{StaticResource PrimaryButton}" Content="Выбрать положение"
                                Click="OnMuteBadgePosition"/>
                        <Button x:Name="MuteBadgeResetButton" Style="{StaticResource FlatButton}" Content="Сбросить положение" Margin="8,0,0,0"
                                Click="OnMuteBadgeResetPosition"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel x:Name="SectionPings" Style="{StaticResource SectionPanel}">
                    <TextBlock Text="Пинги в чате" Style="{StaticResource Heading}"/>

                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Тест" MinWidth="0" Padding="10,1"
                                VerticalAlignment="Center" Margin="8,-3,0,-3" ToolTip="Добавить тестовый пинг" AutomationProperties.Name="Добавить тестовый пинг" Click="OnAddTestPing"/>
                        <Ellipse x:Name="PingsStatusDot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PingsStatusText" Text="Пинги: не подключено" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>

                    <CheckBox x:Name="PingsCheck" Margin="0,10,0,0" Click="OnOptionsChanged"
                              AutomationProperties.Name="Уведомлять о пингах">
                        <TextBlock TextWrapping="Wrap" Text="Уведомлять о пингах"/>
                    </CheckBox>

                    <TextBlock Text="Слова для пингов (кроме @ника)" Style="{StaticResource Label}"/>
                    <DockPanel>
                        <Button x:Name="PingWordAddButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Добавить"
                                Margin="8,0,0,0" Click="OnAddPingWord"/>
                        <TextBox x:Name="PingWordInput" AutomationProperties.Name="Слово для пингов" PreviewKeyDown="OnPingWordKeyDown"
                                 ToolTip="Слово ищется целиком без учёта регистра; * заменяет любые буквы: стрим* найдёт стримы. Слова с пробелами это фраза. Можно вставить сразу несколько через запятую."/>
                    </DockPanel>
                    <ItemsControl x:Name="PingWordsList" ItemTemplate="{StaticResource RemovableChip}" ItemsPanel="{StaticResource WrapItems}"/>
                    <TextBlock x:Name="PingWordsStatus" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Сбросить" Padding="8,0"
                                ToolTip="Вернуть список ботов, который был в начале" Click="OnResetPingIgnored"/>
                        <TextBlock Text="Не считать (боты)" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <Button x:Name="PingIgnoredAddButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Добавить"
                                Margin="8,0,0,0" Click="OnAddPingIgnored"/>
                        <TextBox x:Name="PingIgnoredInput" AutomationProperties.Name="Аккаунт, который не считать" PreviewKeyDown="OnPingIgnoredKeyDown"
                                 ToolTip="Логин аккаунта (@ и заглавные буквы не важны). Можно вставить сразу несколько через запятую."/>
                    </DockPanel>
                    <ItemsControl x:Name="PingIgnoredList" ItemTemplate="{StaticResource RemovableChip}" ItemsPanel="{StaticResource WrapItems}"/>
                </StackPanel>

                <StackPanel x:Name="SectionMoments" Style="{StaticResource SectionPanel}">
                    <TextBlock Text="Рейды и стрики" Style="{StaticResource Heading}"/>

                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Ellipse x:Name="MomentsStatusDot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MomentsStatusText" Text="Рейды и стрики: не подключено" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Тест" MinWidth="0" Padding="10,1"
                                VerticalAlignment="Center" Margin="8,-3,0,-3" ToolTip="Добавить тестовый рейд" AutomationProperties.Name="Добавить тестовый рейд" Click="OnAddTestRaid"/>
                        <CheckBox x:Name="RaidsCheck" Click="OnOptionsChanged" AutomationProperties.Name="Уведомлять о рейдах">
                            <TextBlock TextWrapping="Wrap" Text="Уведомлять о рейдах"/>
                        </CheckBox>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Тест" MinWidth="0" Padding="10,1"
                                VerticalAlignment="Center" Margin="8,-3,0,-3" ToolTip="Добавить тестовый стрик" AutomationProperties.Name="Добавить тестовый стрик" Click="OnAddTestStreak"/>
                        <CheckBox x:Name="StreaksCheck" Click="OnOptionsChanged" AutomationProperties.Name="Уведомлять о стриках">
                            <TextBlock TextWrapping="Wrap" Text="Уведомлять о стриках"/>
                        </CheckBox>
                    </DockPanel>
                    <TextBlock Text="Стрик: зритель отметил в чате, сколько стримов подряд он смотрит." Foreground="{StaticResource MutedBrush}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="SectionChat" Style="{StaticResource SectionPanel}">
                    <TextBlock Text="Чат Twitch" Style="{StaticResource Heading}"/>

                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Ellipse x:Name="ChatStatusDot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                 Margin="0,4,8,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="ChatStatusText" Text="Не подключено" TextWrapping="Wrap"/>
                    </DockPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Фон Чата" VerticalAlignment="Center"/>
                        <Slider x:Name="ChatOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="Непрозрачность фона чата" ValueChanged="OnChatSliderChanged"/>
                        <TextBlock x:Name="ChatOpacityText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Подсветка Сообщений" VerticalAlignment="Center"/>
                        <Slider x:Name="ChatCellSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="Непрозрачность плашки сообщений" ValueChanged="OnChatSliderChanged"/>
                        <TextBlock x:Name="ChatCellText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Обводка Сообщений" VerticalAlignment="Center"/>
                        <Slider x:Name="ChatOutlineSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="Непрозрачность чёрной обводки сообщений" ValueChanged="OnChatSliderChanged"/>
                        <TextBlock x:Name="ChatOutlineText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Размер текста" VerticalAlignment="Center"/>
                        <Slider x:Name="ChatFontSlider" Grid.Column="1" Minimum="10" Maximum="28" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="Размер текста чата" ValueChanged="OnChatSliderChanged"/>
                        <TextBlock x:Name="ChatFontText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Автоматический Мут на -" VerticalAlignment="Center"/>
                        <Slider x:Name="ChatMuteSlider" Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                AutomationProperties.Name="Длительность мута" ValueChanged="OnChatMuteChanged"/>
                        <TextBlock x:Name="ChatMuteText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <TextBlock x:Name="ChatModerationText" Foreground="{StaticResource WarnBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed" Text="Для бана и мута переподключи Twitch (вкладка «Twitch»): нужно новое право."/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="ChatPositionButton" Style="{StaticResource PrimaryButton}" Content="Выбрать положение"
                                Click="OnChatPosition"/>
                        <Button Style="{StaticResource FlatButton}" Content="Сбросить положение" Margin="8,0,0,0"
                                Click="OnChatResetPosition"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <Border x:Name="CreditsBar" Grid.Row="3" Padding="16,4,8,4" BorderBrush="#3A3F4B" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="4" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Свернуть" AutomationProperties.Name="Свернуть подпись" Click="OnCollapseCredits">
                    <Path Data="M4.5,6.5 L8,10 L11.5,6.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="None"/>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}" Padding="5" Margin="2,0,0,0" Tag="https://github.com/NightFuryoOo/StreamHelper" ToolTip="https://github.com/NightFuryoOo/StreamHelper"
                            AutomationProperties.Name="GitHub" Click="OnOpenLink">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" Fill="#E6E8EE"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Padding="5" Margin="2,0,0,0" Tag="https://www.twitch.tv/nightfuryo3o" ToolTip="https://www.twitch.tv/nightfuryo3o"
                            AutomationProperties.Name="Twitch" Click="OnOpenLink">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z" Fill="#A970FF"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Padding="5" Margin="2,0,0,0" Tag="https://t.me/StreameHelper" ToolTip="https://t.me/StreameHelper"
                            AutomationProperties.Name="Telegram" Click="OnOpenLink">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" Fill="#26A5E4"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Padding="5" Margin="2,0,0,0" Tag="https://www.donationalerts.com/r/nightfuryo3o" ToolTip="https://www.donationalerts.com/r/nightfuryo3o"
                            AutomationProperties.Name="DonationAlerts" Click="OnOpenLink">
                        <Image Source="/Assets/donationalerts.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}">
                    <Run Text="Разработчик"/> <Run Text="NightFuryo3o" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                </TextBlock>
            </DockPanel>
        </Border>
        <Border x:Name="CreditsHandle" Grid.Row="3" Padding="0,1,8,1" BorderBrush="#3A3F4B" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <Button Style="{StaticResource FlatButton}" Padding="6,1" HorizontalAlignment="Right"
                    ToolTip="Показать подпись разработчика" AutomationProperties.Name="Развернуть подпись" Click="OnExpandCredits">
                <Path Data="M4.5,9.5 L8,6 L11.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="14" Stretch="None"/>
            </Button>
        </Border>
    </Grid>
</Window>
