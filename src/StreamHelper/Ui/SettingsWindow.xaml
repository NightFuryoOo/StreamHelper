<Window x:Class="StreamHelper.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StreamHelper.Ui"
        Title="StreamHelper — настройки" Icon="/app_icon.ico" Width="900" Height="720" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>

        <Style x:Key="ResetHotkeyButton" TargetType="Button" BasedOn="{StaticResource CrossButton}">
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Сбросить"/>
            <Setter Property="AutomationProperties.Name" Value="Сбросить"/>
        </Style>
        <DataTemplate x:Key="RemovableChip">
            <Border Background="{StaticResource CardBrush}" CornerRadius="13" Padding="10,2,3,2" Margin="0,6,6,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    <Button Style="{StaticResource CrossButton}" Margin="2,0,0,0" VerticalAlignment="Center"
                            ToolTip="Убрать" AutomationProperties.Name="{Binding RemoveName}" Click="OnRemoveEntry"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel/>
        </ItemsPanelTemplate>
        <Style x:Key="SwitchButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" Width="40" Height="22">
                            <Border x:Name="track" Width="34" Height="18" CornerRadius="9" Background="#3A3F4B"/>
                            <Ellipse x:Name="knob" Width="14" Height="14" Fill="#C9CDD6" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="knob" Property="Fill" Value="White"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,5,0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="track" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="knob" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>

        <Style x:Key="SwitchCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="36" Height="20" VerticalAlignment="Top">
                                <Border x:Name="track" Width="34" Height="18" CornerRadius="9" Background="#3A3F4B"
                                        BorderBrush="Transparent" BorderThickness="1"/>
                                <Ellipse x:Name="knob" Width="14" Height="14" Fill="#C9CDD6" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Top" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="knob" Property="Fill" Value="White"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="#8CC0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotifyChip" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#A9AFBC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="#3A3F4B" BorderThickness="1" CornerRadius="11" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8CC0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Width="32" Height="28" BorderBrush="Transparent" BorderThickness="1">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2,12 C2,12 6,5 12,5 C18,5 22,12 22,12 C22,12 18,19 12,19 C6,19 2,12 2,12 Z M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.7"
                                          StrokeLineJoin="Round"/>
                                    <Path x:Name="slash" Data="M4,4 L20,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="slash" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#6B7180"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8CC0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ExpanderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="16,12" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8CC0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ServiceTile" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#1B1D23" BorderBrush="#3A3F4B" BorderThickness="1" CornerRadius="8" Padding="12">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#20242C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B7BDCB"/>
            <Setter Property="Background" Value="#2E3340"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,6,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="#2E333E"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="16,9"/>
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,5,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="TestButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Margin" Value="26,22,26,26"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" BorderBrush="#2A2E37" BorderThickness="0,0,1,0" Padding="10,14,10,14">
            <DockPanel LastChildFill="False">
                <Button x:Name="HelpButton" DockPanel.Dock="Bottom" Style="{StaticResource NavLinkButton}" AutomationProperties.Name="Что умеет программа"
                        ToolTip="Справка обо всём, что умеет StreamHelper" Click="OnOpenHelp">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 M9.6,9.4 A2.5,2.5 0 1 1 13,11.8 C12.3,12.1 12,12.6 12,13.3 V13.6 M12,17 V17.01"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Что умеет программа" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavConnections" Style="{StaticResource NavButton}" GroupName="pages" Tag="connections"
                                 AutomationProperties.Name="Подключения" Checked="OnSectionChecked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M9,2 V7 M15,2 V7 M6,7 H18 V11 A6,6 0 0 1 6,11 Z M12,17 V22"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Подключения" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavEvents" Style="{StaticResource NavButton}" GroupName="pages" Tag="events"
                                 AutomationProperties.Name="События" Checked="OnSectionChecked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6,16 V11 A6,6 0 0 1 18,11 V16 L20,18 H4 Z M10,21 A2,2 0 0 0 14,21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="События" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRewards" Style="{StaticResource NavButton}" GroupName="pages" Tag="rewards"
                                 AutomationProperties.Name="Награды" Checked="OnSectionChecked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4,11 H20 V21 H4 Z M3,7 H21 V11 H3 Z M12,7 V21 M12,7 C10,3 6.5,4 7.5,7 M12,7 C14,3 17.5,4 16.5,7"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Награды" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavChat" Style="{StaticResource NavButton}" GroupName="pages" Tag="chat"
                                 AutomationProperties.Name="Чат" Checked="OnSectionChecked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4,5 H20 V16 H9 L4,20 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Чат" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavButton}" GroupName="pages" Tag="general"
                                 AutomationProperties.Name="Общие" Checked="OnSectionChecked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4,7 H13 M19,7 H20 M4,17 H7 M13,17 H20 M16,4.5 A2.5,2.5 0 1 1 16,9.5 A2.5,2.5 0 1 1 16,4.5 M10,14.5 A2.5,2.5 0 1 1 10,19.5 A2.5,2.5 0 1 1 10,14.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Общие" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:UpdateBanner x:Name="UpdateBannerView" Grid.Row="0" Margin="26,14,26,0"/>
            <TextBlock x:Name="HotkeyHint" Grid.Row="1" Foreground="{StaticResource WarnBrush}" Margin="26,10,26,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>

                    <StackPanel x:Name="PageConnections" Style="{StaticResource Page}">
                        <TextBlock Text="Подключения" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Откуда программа берёт события и чат." Style="{StaticResource PageSub}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button x:Name="TwitchConnectButton" Style="{StaticResource PrimaryButton}" Content="Подключить Twitch"
                                                Click="OnTwitchConnect"/>
                                        <Button x:Name="TwitchDisconnectButton" Style="{StaticResource FlatButton}" Content="Отключить" Margin="6,0,0,0"
                                                Click="OnTwitchDisconnect"/>
                                    </StackPanel>
                                    <Viewbox DockPanel.Dock="Left" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z" Fill="#A970FF"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Twitch" Style="{StaticResource CardTitle}"/>
                                        <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                            <Ellipse x:Name="TwitchStatusDot" DockPanel.Dock="Left" Style="{StaticResource StatusDot}"/>
                                            <TextBlock x:Name="TwitchStatusText" Text="Twitch не подключён." TextWrapping="Wrap" FontSize="12"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="TwitchRightsText" Foreground="{StaticResource WarnBrush}" Margin="32,6,0,0" TextWrapping="Wrap" FontSize="12"
                                           Visibility="Collapsed"/>

                                <StackPanel x:Name="TwitchCodePanel" Visibility="Collapsed" Margin="32,12,0,0">
                                    <TextBlock Text="Код для подтверждения на странице Twitch" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TwitchCodeBox" IsReadOnly="True" FontSize="18" FontWeight="SemiBold" Width="170"/>
                                        <Button Style="{StaticResource FlatButton}" Content="Копировать" Margin="8,0,0,0" Click="OnCopyTwitchCode"/>
                                    </StackPanel>
                                </StackPanel>

                                <DockPanel x:Name="ChannelSummary" Margin="32,10,0,0" LastChildFill="True" Visibility="Collapsed">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Сменить в «Чате»" VerticalAlignment="Center"
                                            AutomationProperties.Name="Сменить канал в разделе «Чат»" Click="OnGoToChannelChoice"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap">
                                        <Run Text="Канал:" Foreground="{StaticResource MutedBrush}"/> <Run x:Name="ChannelSummaryText"/>
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Донаты" Style="{StaticResource CardTitle}"/>
                                <Grid Margin="0,10,-10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TileDonationAlerts" Grid.Column="0" Style="{StaticResource ServiceTile}" Tag="DonationAlerts" Click="OnServiceTileClick"
                                            AutomationProperties.Name="DonationAlerts">
                                        <DockPanel LastChildFill="True">
                                            <Grid DockPanel.Dock="Left" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,10,0">
                                                <Image x:Name="LogoDonationAlerts" Source="/Assets/donationalerts.png" Width="32" Height="32" Opacity="0.45"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border x:Name="BadgeDonationAlerts" Width="17" Height="17" CornerRadius="8.5" BorderBrush="#1B1D23" BorderThickness="2"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="Collapsed">
                                                    <TextBlock x:Name="MarkDonationAlerts" Text="✓" Foreground="White" FontWeight="Bold" FontSize="9"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel>
                                                <TextBlock Text="DonationAlerts" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Ellipse x:Name="StateDotDonationAlerts" Width="8" Height="8" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="StateTextDonationAlerts" Text="Не подключено" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock x:Name="VideoStateDonationAlerts" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <Button x:Name="TileDonatePay" Grid.Column="1" Style="{StaticResource ServiceTile}" Tag="DonatePay" Click="OnServiceTileClick"
                                            AutomationProperties.Name="DonatePay">
                                        <DockPanel LastChildFill="True">
